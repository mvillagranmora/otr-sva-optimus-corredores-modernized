<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cl.bcs</groupId>
    <artifactId>otr-sva-optimus-corredores</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>apv-service</artifactId>
  <packaging>jar</packaging>
  <name>BcsAPVServicios — APV Service (Spring Boot 4.1.1)</name>

  <dependencies>
    <!-- BcsUtils shared library -->
    <dependency>
      <groupId>cl.bcs</groupId>
      <artifactId>bcs-utils</artifactId>
    </dependency>

    <!-- typed contract and legacy JavaCall adapter of the APV service (adapter depends only on bcs-apv-api) -->
    <dependency>
      <groupId>cl.bcs</groupId>
      <artifactId>bcs-apv-api</artifactId>
    </dependency>
    <dependency>
      <groupId>cl.bcs</groupId>
      <artifactId>bcs-apv-javacall-adapter</artifactId>
    </dependency>

    <!-- Spring Boot starters -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- JSON -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>

    <!-- Utilities -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
    </dependency>

    <!-- SAP HANA JDBC driver (runtime) -->
    <dependency>
      <groupId>com.sap.cloud.db.jdbc</groupId>
      <artifactId>ngdbc</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The characterization goldens were recorded under JVM zone UTC (and US English locale: the legacy plain Gson writes dates as "MMM d, yyyy" in the
           default locale); H2 caches the default zone, so the whole suite runs in one fork with the same settings. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Duser.timezone=UTC -Dfile.encoding=UTF-8 -Duser.language=en -Duser.country=US</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- The executable (repackaged) jar is *-exec.jar. The main artifact stays a plain jar, so that
               BcsAPVJobs can use this module as a library (in-process jobs, decision 2026-10-15). -->
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
