# templates are byte-exact copies of the legacy (SHA-256 in templates/MANIFEST*.json): never normalize line endings or treat as text
templates/** -text
templates/**/*.rpt binary
# the recorded legacy goldens are byte-exact outputs of the legacy engine (txt/rtf mix CRLF and LF): with core.autocrlf=true a checkout/commit
# silently rewrites them and EquivalenceTest fails on the txt facet. Keep them as-is.
src/test/resources/crystal/equiv/**/legacy/* -text
