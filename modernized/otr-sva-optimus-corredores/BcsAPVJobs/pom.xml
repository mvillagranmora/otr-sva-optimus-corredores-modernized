<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cl.bcs</groupId>
    <artifactId>otr-sva-optimus-corredores</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>apv-jobs</artifactId>
  <packaging>jar</packaging>
  <name>BcsAPVJobs — APV Job Service (Spring Boot 4.1.1)</name>

  <dependencies>
    <!-- BcsUtils shared library -->
    <dependency>
      <groupId>cl.bcs</groupId>
      <artifactId>bcs-utils</artifactId>
    </dependency>

    <!-- typed use cases and legacy JSON mapping of the APV service (plain jars) -->
    <dependency>
      <groupId>cl.bcs</groupId>
      <artifactId>bcs-apv-api</artifactId>
    </dependency>
    <dependency>
      <groupId>cl.bcs</groupId>
      <artifactId>bcs-apv-javacall-adapter</artifactId>
    </dependency>
    <!-- BcsAPVServicios as an in-process library (decision 2026-10-15: the jobs call its use cases and ports directly, no HTTP).
         The Servicios pom builds the plain jar (this one) and the executable apv-service-*-exec.jar. -->
    <dependency>
      <groupId>cl.bcs</groupId>
      <artifactId>apv-service</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Spring Boot starters -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- JSON for TomEE proxy responses and job parameter parsing -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>

    <!-- SAP HANA JDBC driver (runtime) -->
    <dependency>
      <groupId>com.sap.cloud.db.jdbc</groupId>
      <artifactId>ngdbc</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- the goldens were recorded under JVM zone UTC and US English locale; one fork with the same settings -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Duser.timezone=UTC -Dfile.encoding=UTF-8 -Duser.language=en -Duser.country=US</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
