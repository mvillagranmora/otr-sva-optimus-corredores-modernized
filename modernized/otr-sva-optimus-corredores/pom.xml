<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>cl.bcs</groupId>
  <artifactId>otr-sva-optimus-corredores</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Optimus Corredores — Spring Boot 4.1.1 / Java 25</name>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- External integration versions -->
    <jsch.version>0.2.19</jsch.version>
    <gson.version>2.11.0</gson.version>
    <commons-io.version>2.17.0</commons-io.version>
    <commons-beanutils.version>1.9.4</commons-beanutils.version>
    <wiremock.version>3.10.0</wiremock.version>
    <!-- SAP HANA JDBC — from libs-private, version pinned to legacy -->
    <ngdbc.version>2.8.12</ngdbc.version>
    <!-- Spring Web Services (SOAP endpoints for Tesorería SvcRecauda*) -->
    <spring-ws.version>4.0.12</spring-ws.version>
    <!-- OpenCSV for job file generation -->
    <opencsv.version>5.9</opencsv.version>
  </properties>

  <modules>
    <module>BcsUtils</module>
    <module>BcsNormativaCore</module>
    <module>BcsNormativaJobs</module>
    <module>BcsContabilidadServicios</module>
    <module>BcsTesoreriaServicios</module>
    <module>BcsTesoreriaJobs</module>
    <module>BcsAPVApi</module>
    <module>BcsApvJavaCallAdapter</module>
    <module>BcsAPVServicios</module>
    <module>BcsAPVJobs</module>
    <module>BcsCuentaInversionServicios</module>
    <module>BcsCuentaInversionJobs</module>
    <module>BcsContabilidadJobs</module>
    <module>BcsMesaServicios</module>
    <module>BcsOrdenServicios</module>
    <module>BcsPortafolioServicios</module>
    <module>BcsValo2</module>
    <module>BcsJobOrders</module>
    <module>BcsMesaJobs</module>
    <module>BcsOrdenJobs</module>
    <module>BcsBECB</module>
    <module>BcsSURA</module>
    <module>BcsReplica</module>
    <module>BcsSocioNegocioJobs</module>
    <module>BcsFacturacionJobs</module>
    <module>BcsCustodiaJobs</module>
    <module>BcsSocioNegocioServicios</module>
    <module>BcsCustodiaServicios</module>
    <module>BcsFacturacionServicios</module>
    <module>BcsFilters</module>
    <module>BcsJobManager</module>
    <module>BcsPortalConfirmacionWeb</module>
    <module>BcsCartolasMaster</module>
    <module>BcsTributarioJobs</module>
    <module>BcsCartolasJobs</module>
    <module>BcsCanalAgenteServicios</module>
    <module>BcsPlataformaReporteApi</module>
    <module>BcsPlataformaJobs</module>
    <module>BcsCartolas</module>
    <module>BcsJobsFondoMutuo</module>
    <!-- BcsCrystalReports is NOT listed here — standalone Java 11 / Spring Boot 2.7 service (Crystal Reports SDK incompatible with Java 25) -->
    <module>BcsFondoMutuoServicios</module>
    <module>BcsPlataformaWeb</module>
    <module>BcsNormativaServicios</module>
    <module>BcsPlataformaServicios</module>
    <module>BcsGateway</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>cl.bcs</groupId>
        <artifactId>bcs-utils</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cl.bcs</groupId>
        <artifactId>bcs-apv-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cl.bcs</groupId>
        <artifactId>bcs-apv-javacall-adapter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>${gson.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>${commons-io.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-beanutils</groupId>
        <artifactId>commons-beanutils</artifactId>
        <version>${commons-beanutils.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.mwiede</groupId>
        <artifactId>jsch</artifactId>
        <version>${jsch.version}</version>
      </dependency>
      <dependency>
        <groupId>com.sap.cloud.db.jdbc</groupId>
        <artifactId>ngdbc</artifactId>
        <version>${ngdbc.version}</version>
        <scope>runtime</scope>
      </dependency>
      <dependency>
        <groupId>org.wiremock</groupId>
        <artifactId>wiremock</artifactId>
        <version>${wiremock.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- Spring Web Services (SOAP) -->
      <dependency>
        <groupId>org.springframework.ws</groupId>
        <artifactId>spring-ws-core</artifactId>
        <version>${spring-ws.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.ws</groupId>
        <artifactId>spring-ws-test</artifactId>
        <version>${spring-ws.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- OpenCSV for job file generation -->
      <dependency>
        <groupId>com.opencsv</groupId>
        <artifactId>opencsv</artifactId>
        <version>${opencsv.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>5.3.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>project-libs-private</id>
      <url>file://${project.basedir}/../../legacy/otr-sva-optimus-corredores/libs-private-mvn</url>
    </repository>
  </repositories>

</project>
