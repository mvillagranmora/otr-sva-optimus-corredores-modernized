# Compilación y artefactos de Maven (recursivo en subcarpetas)
**/target/
**/build/
**/.gradle/
**/bin/
**/out/
!**/src/**/out/

# Entornos de desarrollo y variables globales o locales
.env
**/.env
**/.env.*
!.env.example
**/!.env.example

# Contenedores y orquestación por subproyecto
**/.dockerignore
**/Dockerfile.local
**/docker-compose.override.yml

# IDEs y editores (configuraciones globales o por subdirectorio)
.idea/
**/.idea/
*.iml
**/*.iml
.classpath
**/.classpath
.project
**/.project
.settings/
**/.settings/
.vscode/
**/.vscode/
*.swp
*.swo

# Registros de logs y bases de datos locales incrustadas
*.log
**/logs/
*.sqlite
*.db
**/*.sqlite
**/*.db

# Archivos propios del sistema operativo
.DS_Store
Thumbs.db