<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cl.bcs</groupId>
    <artifactId>otr-sva-optimus-corredores</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>bcs-contabilidad-jobs</artifactId>
  <name>BcsContabilidadJobs — Spring Boot 4.1.1 / Java 25</name>

  <dependencies>
    <!-- BcsContabilidadServicios as an in-process library (its plain jar; the executable one is *-exec.jar).
         Spring Batch is not used by the jobs: excluded, so that its auto-configuration does not start here. -->
    <dependency>
      <groupId>cl.bcs</groupId>
      <artifactId>contabilidad-service</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-batch</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Step 5 (collaborators in process, JOBS_PATTERN.md H-1): the OWNER of the one group M collaborator the Contabilidad services reach
         (ConsultarClearingFinanciero of Tesoreria) runs inside the job transaction instead of going over HTTP. Plain jar, no Maven cycle
         (tesoreria-service does not depend on contabilidad-service); no compile-time dependency from one library to the other either, the
         link is made at this application (config/ColaboradoresEnProcesoConfiguration). It ships application.properties only; the one of
         contabilidad-service comes first on the classpath and wins (pinned by ColaboradoresEnProcesoWiringTest). -->
    <dependency>
      <groupId>cl.bcs</groupId>
      <artifactId>tesoreria-service</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- tesoreria-service pins jakarta.xml.ws-api 4.0.2; the Spring Boot BOM would raise the transitive one to 4.0.3. -->
    <dependency>
      <groupId>jakarta.xml.ws</groupId>
      <artifactId>jakarta.xml.ws-api</artifactId>
      <version>4.0.2</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>
    <!-- SAP HANA JDBC driver (runtime) -->
    <dependency>
      <groupId>com.sap.cloud.db.jdbc</groupId>
      <artifactId>ngdbc</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
