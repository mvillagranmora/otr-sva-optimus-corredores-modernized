<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cl.bcs</groupId>
    <artifactId>otr-sva-optimus-corredores</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>bcs-cuenta-inversion-jobs</artifactId>
  <name>BcsCuentaInversionJobs — Investment Account Job Service (Spring Boot 4.1.1 / Java 25)</name>

  <dependencies>
    <!-- BcsUtils shared library -->
    <dependency>
      <groupId>cl.bcs</groupId>
      <artifactId>bcs-utils</artifactId>
    </dependency>

    <!-- BcsCuentaInversionServicios as an in-process library (decision 2026-10-15: the jobs call its services directly, no HTTP).
         The Servicios pom builds the plain jar (this one) and the executable bcs-cuenta-inversion-servicios-*-exec.jar. -->
    <dependency>
      <groupId>cl.bcs</groupId>
      <artifactId>bcs-cuenta-inversion-servicios</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Spring Boot starters. The jobs are run on request through POST /internal/job-call: the web starter is needed for that
         endpoint (the obsolete pilot had none). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- JSON of the service contracts -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>

    <!-- SAP HANA JDBC driver (runtime) -->
    <dependency>
      <groupId>com.sap.cloud.db.jdbc</groupId>
      <artifactId>ngdbc</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The legacy goldens were recorded under JVM zone UTC, locale en-US (legacy-oracle/record.sh); H2 caches the default zone, so the
           whole suite runs in one UTC fork with UTF-8 file encoding (the legacy files are written with the platform charset). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@src/test/surefire-jvm.args</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
