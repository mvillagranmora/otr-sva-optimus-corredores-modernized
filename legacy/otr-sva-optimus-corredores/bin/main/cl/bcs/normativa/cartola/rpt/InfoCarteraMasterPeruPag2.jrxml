				<textFieldExpression   class="java.lang.String"><![CDATA[$P{parametros}.get("PageFooter_TextoPiePagina")]]></textFieldExpression>
				</textField>
			</band>
		</pageFooter>
		<summary>
			<band height="0"  isSplitAllowed="true" >
			</band>
		</summary>
</jasperReport>
