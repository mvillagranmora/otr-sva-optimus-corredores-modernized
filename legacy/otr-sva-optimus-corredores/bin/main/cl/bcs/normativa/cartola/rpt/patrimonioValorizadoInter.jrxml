					<bottomPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[(!$F{roundMont}.equals("S"))?(new DecimalFormat("#,##0.00").format($F{monto}.doubleValue())):(new DecimalFormat("#,##0").format($F{monto}.doubleValue()))]]></textFieldExpression>
			</textField>
