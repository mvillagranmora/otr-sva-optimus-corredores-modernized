	<parameter name="parametros" class="java.util.Map" isForPrompting="false"/>
	<queryString>
		<![CDATA[select 'Pesos (CLP) ' as item , cast ('123123123' as dec(14,3) ) as monto 
		union all
	select 'unid. Fomento (UF)' as item , cast ('3453453' as dec(14,3) ) as monto
		union all
	select 'Dolar (USD)' as item , cast ('753335' as dec(14,3) ) as monto]]>
	</queryString>
	<field name="item" class="java.lang.String"/>
	<field name="monto" class="java.math.BigDecimal"/>
	<field name="roundMont" class="java.lang.String"/>
