		<variableExpression><![CDATA[($F{MONEDA}.equalsIgnoreCase("USD"))
? new BigDecimal($V{SUM_TOTAL_USD}.doubleValue() + $F{MON_ACT_VAL}.doubleValue()) : new BigDecimal($V{SUM_TOTAL_USD}.doubleValue())]]></variableExpression>
		<initialValueExpression><![CDATA[new BigDecimal("0")]]></initialValueExpression>
