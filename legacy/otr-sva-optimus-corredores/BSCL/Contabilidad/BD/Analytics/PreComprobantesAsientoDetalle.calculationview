 /********* Begin Procedure Script ************/ 
 BEGIN 
 	 var_out = SELECT 
			PRE.&quot;IdPreComprobante&quot;,
			EPCA.&quot;IdPreComprobanteAsiento&quot;,
			EPCA.&quot;IdEvento&quot;,
			MV.&quot;IdMovimiento&quot;,
			EPCA.&quot;Operador&quot;,
			EPCA.&quot;Linea&quot;,
			EPCA.&quot;Estado&quot;,
			EPCA.&quot;GlosaDetalle&quot;,
			EV.&quot;IdTipoEvento&quot;,
			EV.&quot;Monto&quot;,
			MV.&quot;Numero&quot;
		FROM &quot;BSCL.Contabilidad.BD::ITZ.PreComprobante&quot; PRE
		LEFT JOIN &quot;BSCL.Contabilidad.BD::ITZ.PreComprobanteAsiento&quot; PREA ON PRE.&quot;IdPreComprobante&quot; = PREA.&quot;IdPreComprobante&quot;
		LEFT JOIN &quot;BSCL.Contabilidad.BD::ITZ.EventoPreComprobanteAsiento&quot; EPCA ON PREA.&quot;IdPreComprobanteAsiento&quot; = EPCA.&quot;IdPreComprobanteAsiento&quot;
		LEFT JOIN &quot;BSCL.Contabilidad.BD::ITZ.Evento&quot; EV ON EPCA.&quot;IdEvento&quot; = EV.&quot;IdEvento&quot; 
		LEFT JOIN &quot;BSCL.Contabilidad.BD::ITZ.Movimiento&quot; MV ON MV.&quot;IdMovimiento&quot; = EV.&quot;IdMovimiento&quot;;

END /********* End Procedure Script ************/</definition>
