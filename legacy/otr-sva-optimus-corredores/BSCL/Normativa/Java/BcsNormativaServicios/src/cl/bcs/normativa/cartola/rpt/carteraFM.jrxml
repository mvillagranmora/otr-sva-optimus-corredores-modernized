	<parameter name="parametros" isForPrompting="false" class="java.util.Map"/>
	<queryString><![CDATA[exec pa_selInfoMensualCarteraFm '12085472-0' , '0','']]></queryString>

	<field name="alert" class="java.lang.String"/>
	<field name="nemo" class="java.lang.String"/>
	<field name="emisor" class="java.lang.String"/>
	<field name="serie" class="java.lang.String"/>
	<field name="RAZON_SOCIAL" class="java.lang.String"/>
	<field name="CAN_CUSTODIA" class="java.math.BigDecimal"/>
	<field name="garantia" class="java.math.BigDecimal"/>
	<field name="valorCuotaAporte" class="java.math.BigDecimal"/>
	<field name="valorCuotaActual" class="java.math.BigDecimal"/>
	<field name="COD_IMP_RES" class="java.lang.String"/>
	<field name="IND_DIFERIDO" class="java.lang.String"/>
	<field name="NEMO_ASOC" class="java.lang.String"/>
	<field name="TASA_CAMBIO" class="java.math.BigDecimal"/>
	<field name="BLOQUEO_FONDO" class="java.math.BigDecimal"/>
	<field name="TIR_CONTAB" class="java.math.BigDecimal"/>
	<field name="TIPO_FAM" class="java.lang.String"/>
	<field name="categorizacion" class="java.lang.String"/>
	<field name="MONTO_VALORIZ" class="java.math.BigDecimal"/>
	<field name="valorActual" class="java.math.BigDecimal"/>
	<field name="RENTABILIDAD" class="java.math.BigDecimal"/>
	<field name="ID_MONEDA_INSTRUMENTO" class="java.lang.String"/>
	<field name="MONTO_APORTE" class="java.math.BigDecimal"/>
	<field name="MontoMonedaInstrumento" class="java.math.BigDecimal"/>
	<field name="MontoCalculadoMonInstrumento" class="java.math.BigDecimal"/>
	<field name="PromedioAporte" class="java.math.BigDecimal"/>

	<sortField name="ID_MONEDA_INSTRUMENTO" />

	<variable name="SUM_valorActual_1" class="java.math.BigDecimal" resetType="Group" resetGroup="moneda" calculation="Sum">
		<variableExpression><![CDATA[$F{ID_MONEDA_INSTRUMENTO} != null && !$F{ID_MONEDA_INSTRUMENTO}.equals("CLP") 
    ? $F{MontoCalculadoMonInstrumento} 
    : $F{MONTO_VALORIZ}.setScale(0, 1)]]></variableExpression>
	</variable>
	<variable name="TOT_rentabilidad_1" class="java.math.BigDecimal" resetType="Group" resetGroup="moneda" calculation="Sum">
		<variableExpression><![CDATA[$F{MONTO_VALORIZ}.multiply($F{RENTABILIDAD})]]></variableExpression>
	</variable>
	<variable name="VAL_rentabilidad_1" class="java.math.BigDecimal" resetType="Group" resetGroup="moneda" calculation="Nothing">
		<variableExpression><![CDATA[($V{SUM_valorActual_1}.doubleValue() == 0 || $V{TOT_rentabilidad_1}.doubleValue() == 0 )?new BigDecimal(0.0):$V{TOT_rentabilidad_1}.divide($V{SUM_valorActual_1}, 4)]]></variableExpression>
	</variable>
	<variable name="SUM_valorAporte" class="java.math.BigDecimal" resetType="Group" resetGroup="moneda" calculation="Sum">
		<variableExpression><![CDATA[$F{CAN_CUSTODIA}
.add($F{garantia},java.math.MathContext.DECIMAL128)
.multiply($F{PromedioAporte},java.math.MathContext.DECIMAL128) 
]]></variableExpression>
	</variable>
	<variable name="resultado_rentabilidad_FM" class="java.math.BigDecimal" resetType="Group" resetGroup="moneda" calculation="Nothing">
		<variableExpression><![CDATA[$V{SUM_valorAporte}.doubleValue() > 0 ? 
$V{SUM_valorActual_1}
.subtract( $V{SUM_valorAporte}, java.math.MathContext.DECIMAL128)
.divide( $V{SUM_valorAporte},java.math.MathContext.DECIMAL128)
.multiply(new BigDecimal("100"),java.math.MathContext.DECIMAL128) :
BigDecimal.ZERO]]></variableExpression>
	</variable>
	<variable name="SUM_Instrumentos" class="java.lang.Integer" resetType="Group" resetGroup="moneda" calculation="Nothing">
		<variableExpression><![CDATA[$F{nemo} != null && !$F{nemo}.trim().isEmpty()
    ? new Integer($V{SUM_Instrumentos}.intValue() + 1)
    : new Integer($V{SUM_Instrumentos}.intValue())]]></variableExpression>
		<initialValueExpression><![CDATA[new Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="SUM_valorActual_2" class="java.math.BigDecimal" resetType="Group" resetGroup="moneda" calculation="Sum">
		<variableExpression><![CDATA[$F{ID_MONEDA_INSTRUMENTO} != null && !$F{ID_MONEDA_INSTRUMENTO}.equals("CLP") 
    ? $F{MontoCalculadoMonInstrumento} 
    : $F{MONTO_VALORIZ}.setScale(0, 1)
]]></variableExpression>
	</variable>

		<group  name="moneda" >
			<groupExpression><![CDATA[($F{ID_MONEDA_INSTRUMENTO} == null || "".equals($F{ID_MONEDA_INSTRUMENTO}.trim())) 
 ? "CLP" 
 : $F{ID_MONEDA_INSTRUMENTO}.trim()]]></groupExpression>
