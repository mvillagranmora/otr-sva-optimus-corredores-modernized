	<style name="fondoSubtitle" isDefault="false" mode="Opaque" forecolor="#000000" backcolor="#CAFFF4"/>
	<style name="notas" isDefault="false" mode="Opaque" forecolor="#000000" backcolor="#CAFFF4" hAlign="Left" vAlign="Middle" fontName="Arial" fontSize="8"/>
	<style name="piePagina1" isDefault="false" mode="Transparent" forecolor="#000000" hAlign="Center" vAlign="Middle" fontName="Verdana" fontSize="5"/>
	<style name="piePagina2" isDefault="false" mode="Opaque" forecolor="#000000" backcolor="#000000" hAlign="Center" vAlign="Middle" fontName="Verdana" fontSize="8" isBold="true"/>
	<style name="piePagina3" isDefault="false" mode="Transparent" forecolor="#000000" hAlign="Center" vAlign="Middle" fontName="Verdana" fontSize="4"/>
	<style name="gridEncabezadoCust" isDefault="false" mode="Opaque" forecolor="#FFFFFF" backcolor="#000000" hAlign="Left" vAlign="Middle" fontName="Arial" fontSize="8" isBold="true"/>
	<style name="gridEncabezado" isDefault="false" mode="Opaque" forecolor="#FFFFFF" backcolor="#000000" hAlign="Left" vAlign="Middle" fontName="Arial" fontSize="7" isBold="true"/>
	<style name="gridEncabezado2" isDefault="false" mode="Opaque" forecolor="#FFFFFF" backcolor="#000000" hAlign="Right" vAlign="Middle" fontName="Arial" fontSize="7" isBold="true"/>
	<style name="subTitleGrid" isDefault="false" mode="Opaque" forecolor="#000000" backcolor="#C0C0C0" hAlign="Left" vAlign="Middle" fontName="Arial" fontSize="7" isBold="true"/>
	<style name="subTitleGrid2" isDefault="false" mode="Opaque" forecolor="#000000" backcolor="#C0C0C0" hAlign="Right" vAlign="Middle" fontName="Arial" fontSize="7" isBold="true"/>
	<style name="letrasDetalleRight" isDefault="false" mode="Transparent" forecolor="#000000" hAlign="Right" vAlign="Middle" fontName="Arial" fontSize="7"/>
	<style name="letrasDetalleLeft" isDefault="false" mode="Transparent" forecolor="#000000" hAlign="Left" vAlign="Middle" fontName="Arial" fontSize="7"/>
	<style name="letrasDetalleCenter" isDefault="false" mode="Transparent" forecolor="#000000" hAlign="Center" vAlign="Middle" fontName="Arial" fontSize="7"/>
	<style name="gridEncabezadoMini" isDefault="false" mode="Transparent" forecolor="#FFFFFF" hAlign="Right" vAlign="Middle" fontName="Arial" fontSize="5"/>
	<style name="letraMini" isDefault="false" mode="Transparent" forecolor="#000000" hAlign="Left" vAlign="Middle" fontName="Verdana" fontSize="4"/>
	<parameter name="parametros" class="java.util.Map" isForPrompting="false"/>
	<field name="Item" class="java.lang.String"/>
	<field name="Monto" class="java.math.BigDecimal"/>
	<field name="Moneda" class="java.lang.String"/>
	<field name="Render" class="java.lang.Integer"/>
	<group name="moneda" >
		<groupExpression><![CDATA[(($F{Moneda} == null) ? "CLP" : $F{Moneda})]]></groupExpression>
		<groupHeader>
			<band height="12" splitType="Stretch">
				<textField isBlankWhenNull="false">
					<reportElement key="textField-12" style="subTitleGrid" x="0" y="0" width="117" height="12"/>
					<box leftPadding="1">
						<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement>
						<font size="8"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[(($F{Moneda} == null) ? "CLP" : $F{Moneda})]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement key="staticText-2" style="subTitleGrid2" x="117" y="0" width="118" height="12"/>
					<box rightPadding="1">
						<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement>
						<font size="8"/>
					</textElement>
					<text><![CDATA[Mes Actual]]></text>
				</staticText>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="16" splitType="Stretch"/>
		</groupFooter>
	</group>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="10" splitType="Stretch">
			<textField isBlankWhenNull="false">
				<reportElement key="textField-8" style="gridEncabezadoCust" x="0" y="0" width="235" height="10"/>
				<box leftPadding="1">
					<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA["Resumen de Variación de Patrimonio"
/*$P{parametros}.get("FMG_titulo")*/]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band splitType="Stretch"/>
	</columnHeader>
	<detail>
		<band height="11" splitType="Stretch">
			<textField pattern="" isBlankWhenNull="true">
				<reportElement key="textField" style="letrasSubtitleVaalue2" x="0" y="0" width="117" height="10" printWhenGroupChanges="moneda"/>
				<box leftPadding="1">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement markup="styled"/>
				<textFieldExpression class="java.lang.String"><![CDATA["<style isBold='" + (($F{Render}.intValue() == 1) ? "true' pdfFontName='Helvetica-Bold'" : "false'") + " >" + $F{Item} + "</style>"]]></textFieldExpression>
			</textField>
			<textField pattern="" isBlankWhenNull="false">
				<reportElement key="textField" x="117" y="0" width="118" height="10"/>
				<box rightPadding="1">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Right" markup="styled">
					<font fontName="Arial" size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["<style isBold='" + (($F{Render}.intValue() == 1) ? "true' pdfFontName='Helvetica-Bold'" : "false'") + " >"
+ (($F{Moneda} == "USD")
    ? new net.excelsys.stockMarket.util.Format().numberFormatUsd($F{Monto})
    : new net.excelsys.stockMarket.util.Format().numberFormatClp($F{Monto}))
+ "</style>"]]></textFieldExpression>
			</textField>
		</band>
	</detail>
