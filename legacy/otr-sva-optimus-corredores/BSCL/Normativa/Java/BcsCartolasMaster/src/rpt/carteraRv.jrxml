    </variable>
    <variable name="RENTABLIDAD_TOTAL" class="java.lang.Double" resetType="Report" calculation="Nothing">
        <variableExpression><![CDATA[new Double(((($V{SUM_valor_mercado_1}.doubleValue() + $V{SUM_DIVIDENDOS}.doubleValue())/$V{SUM_VALOR_INVER}.doubleValue())-1)*100)]]></variableExpression>
    </variable>
    <variable name="mostrarPasivo" class="java.lang.Boolean" resetType="Report" calculation="Nothing">
        <variableExpression><![CDATA[new Boolean($F{DisponiblePasivo}.doubleValue() != 0 || $F{GarantiaPasivo}.doubleValue() != 0 || $F{PrestamoPasivo}.doubleValue() != 0 ||
$F{PlazoPasivo}.doubleValue() != 0)]]></variableExpression>
        <initialValueExpression><![CDATA[new Boolean(false)]]></initialValueExpression>
    </variable>
    <variable name="COUNT_Activo" class="java.lang.Integer" resetType="Group" resetGroup="mercado" calculation="Nothing">
        <variableExpression><![CDATA[($F{DisponibleActivo}.doubleValue() != 0 || $F{PrestamoActivo}.doubleValue() != 0 ||
$F{GarantiaActivo}.doubleValue() != 0 || $F{PlazoActivo}.doubleValue() != 0)
? new Integer($V{COUNT_Activo}.intValue() + 1) : new Integer($V{COUNT_Activo}.intValue())]]></variableExpression>
        <initialValueExpression><![CDATA[new Integer(0)]]></initialValueExpression>
    </variable>
    <variable name="COUNT_Pasivo" class="java.lang.Integer" resetType="Group" resetGroup="mercado" calculation="Nothing">
        <variableExpression><![CDATA[($F{DisponiblePasivo}.doubleValue() != 0 || $F{PrestamoPasivo}.doubleValue() != 0 ||
$F{GarantiaPasivo}.doubleValue() != 0 || $F{PlazoPasivo}.doubleValue() != 0)
? new Integer($V{COUNT_Pasivo}.intValue() + 1) : new Integer($V{COUNT_Pasivo}.intValue())]]></variableExpression>
        <initialValueExpression><![CDATA[new Integer(0)]]></initialValueExpression>
    </variable>
    <variable name="SUM_valor_mercado_P" class="java.math.BigDecimal" resetType="Group" resetGroup="mercado" calculation="Sum">
        <variableExpression><![CDATA[$F{MontoMercadoMonedaSistemaPasivo}]]></variableExpression>
    </variable>
    <variable name="RENTABLIDAD_TOTAL_A" class="java.lang.Double" resetType="Report" calculation="Nothing">
        <variableExpression><![CDATA[( ($P{parametros}.get("PRV_RENT_SIN_DIVIDENDOS") != null) && ($P{parametros}.get("PRV_RENT_SIN_DIVIDENDOS").toString().equals("true"))) ?
($V{SUM_VALOR_INVER_A}.doubleValue() == 0) ? new Double(0.0) : new Double(((($V{SUM_valor_mercado_A}.doubleValue() / $V{SUM_VALOR_INVER_A}.doubleValue()) - 1) * 100)) :
($V{SUM_VALOR_INVER_A}.doubleValue() == 0) ? new Double(0.0) : new Double(((($V{SUM_valor_mercado_A}.doubleValue() + $V{SUM_DIVIDENDOS_A}.doubleValue()) / $V{SUM_VALOR_INVER_A}.doubleValue()) - 1) * 100)]]></variableExpression>
    </variable>
    <variable name="RENTABLIDAD_TOTAL_P" class="java.lang.Double" resetType="Report" calculation="Nothing">
        <variableExpression><![CDATA[($V{SUM_VALOR_INVER_P}.doubleValue() == 0) ? new Double(0.0) : new Double(((($V{SUM_valor_mercado_P}.doubleValue() + $V{SUM_DIVIDENDOS_P}.doubleValue()) / $V{SUM_VALOR_INVER_P}.doubleValue()) - 1) * 100)]]></variableExpression>
    </variable>
    <variable name="esMercadoInter" class="java.lang.Integer" resetType="None" calculation="Sum">
        <variableExpression><![CDATA[new Integer($F{IdClasificacionTipoInstrumento}.equalsIgnoreCase("ET")||$F{IdClasificacionTipoInstrumento}.equalsIgnoreCase("ST")||$F{IdClasificacionTipoInstrumento}.equalsIgnoreCase("AO")?1:0)]]></variableExpression>
        <initialValueExpression><![CDATA[new Integer(0)]]></initialValueExpression>
    </variable>
    <variable name="SUM_valor_mercado_A" class="java.math.BigDecimal" resetType="Group" resetGroup="mercado" calculation="Sum">
        <variableExpression><![CDATA[$F{MontoMercadoMonedaSistemaActivo}]]></variableExpression>
    </variable>
    <variable name="mostrarTotalPasivo" class="java.lang.Boolean" resetType="Report" calculation="Nothing">
        <variableExpression><![CDATA[new Boolean($V{SUM_valor_mercado_P}.doubleValue() != 0)]]></variableExpression>
        <initialValueExpression><![CDATA[new Boolean(false)]]></initialValueExpression>
    </variable>

