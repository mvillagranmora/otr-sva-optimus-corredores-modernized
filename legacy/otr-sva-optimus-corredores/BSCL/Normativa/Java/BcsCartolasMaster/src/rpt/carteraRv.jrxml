    <variable name="SUM_valor_mercado_1" class="java.math.BigDecimal" resetType="Group" resetGroup="mercado" calculation="Sum">
        <variableExpression><![CDATA[$F{VALOR_MERCADO}]]></variableExpression>
    </variable>
    <variable name="SUM_DIVIDENDOS" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
        <variableExpression><![CDATA[$F{DIVIDENDOS}]]></variableExpression>
    </variable>
    <variable name="SUM_DIVIDENDOS_A" class="java.math.BigDecimal" resetType="Group" resetGroup="mercado" calculation="Sum">
        <variableExpression><![CDATA[($F{VAL_INVER_A}.longValue()==0?new BigDecimal("0"):$F{DIVIDENDOS_A})]]></variableExpression>
    </variable>
    <variable name="SUM_DIVIDENDOS_P" class="java.math.BigDecimal" resetType="Group" resetGroup="mercado" calculation="Sum">
