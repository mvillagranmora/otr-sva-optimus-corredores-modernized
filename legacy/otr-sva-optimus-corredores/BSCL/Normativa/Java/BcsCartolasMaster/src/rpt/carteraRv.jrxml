                <textFieldExpression   class="java.lang.String"><![CDATA["<style forecolor = '" + (($V{RENTABLIDAD_TOTAL_A}.doubleValue() > 0) ? "blue" : "red") + "' >"  + (((((new net.excelsys.stockMarket.util.Format()).numberFormatTwoDecimal($V{RENTABLIDAD_TOTAL_A})).substring(((new net.excelsys.stockMarket.util.Format()).numberFormatTwoDecimal($V{RENTABLIDAD_TOTAL_A})).indexOf(",") + 1)).length() > 2) ? ((new net.excelsys.stockMarket.util.Format()).numberFormatTwoDecimal($V{RENTABLIDAD_TOTAL_A})).substring(0, ((new net.excelsys.stockMarket.util.Format()).numberFormatTwoDecimal($V{RENTABLIDAD_TOTAL_A})).length() - 1) : (new net.excelsys.stockMarket.util.Format()).numberFormatTwoDecimal($V{RENTABLIDAD_TOTAL_A})) + "%</style>"]]></textFieldExpression>
