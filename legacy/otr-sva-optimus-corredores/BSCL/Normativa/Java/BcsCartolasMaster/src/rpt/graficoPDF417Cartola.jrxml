"|" + (($F{cuenta} == null) ? "" : $F{cuenta}.toString()) +
"|" + (($F{nombre} == null) ? "" : $F{nombre}) +
"|" + (($F{direccionCodBarra} == null) ? "" : $F{direccionCodBarra}) +
"|" + (($F{numeroCodBarra} == null) ? "" : $F{numeroCodBarra}) +
"|" + (($F{complemento} == null) ? "" : $F{complemento}) +
"|" + (($F{comunaCodBarra} == null) ? "" : $F{comunaCodBarra}) +
"|" + (($F{ciudadCodBarra} == null) ? "" : $F{ciudadCodBarra}) +
"|" + (($F{pais} == null) ? "" : $F{pais}) +
(($P{codBarrasIni} == null) ? "" : $P{codBarrasIni}) +
"|SI:" + (($F{saldoInicialMov} == null) ? "0" : new net.excelsys.stockMarket.util.Format().numberFormat($F{saldoInicialMov},new java.util.Locale("es", "CL"),"####0")) +
"|SF:" + (($F{saldoFinalMov} == null) ? "0" : new net.excelsys.stockMarket.util.Format().numberFormat($F{saldoFinalMov},new java.util.Locale("es", "CL"),"####0")) +
"|CA:" + (($F{totalCaja} == null) ? "0" : new net.excelsys.stockMarket.util.Format().numberFormat($F{totalCaja},new java.util.Locale("es", "CL"),"####0")) +
"|RV:" + (($F{totalRv} == null) ? "0" : new net.excelsys.stockMarket.util.Format().numberFormat($F{totalRv},new java.util.Locale("es", "CL"),"####0")) +
"|RF:" + (($F{totalRf} == null) ? "0" : new net.excelsys.stockMarket.util.Format().numberFormat($F{totalRf},new java.util.Locale("es", "CL"),"####0")) +
"|DE:" + (($F{totalDer} == null) ? "0" : new net.excelsys.stockMarket.util.Format().numberFormat($F{totalDer},new java.util.Locale("es", "CL"),"####0")) +
"|FM:" + (($F{totalFm} == null) ? "0" : new net.excelsys.stockMarket.util.Format().numberFormat($F{totalFm},new java.util.Locale("es", "CL"),"####0")) +
"|LQ:" + (($F{totalOp} == null) ? "0" : new net.excelsys.stockMarket.util.Format().numberFormat($F{totalOp},new java.util.Locale("es", "CL"),"####0")) +
"|AB:" + (($F{abonosClp} == null) ? "0" : new net.excelsys.stockMarket.util.Format().numberFormat($F{abonosClp},new java.util.Locale("es", "CL"),"####0")) +
"|RE:" + (($F{retirosClp} == null) ? "0" : new net.excelsys.stockMarket.util.Format().numberFormat($F{retirosClp},new java.util.Locale("es", "CL"),"####0"))
)]]></imageExpression>
