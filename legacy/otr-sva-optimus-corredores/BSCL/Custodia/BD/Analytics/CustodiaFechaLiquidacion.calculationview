		,cast(&quot;ValorMercadoSimulVen&quot; as decimal(26,8)) 			as &quot;ValorMercadoSimulVen&quot;&#xD;
		,cast(&quot;DiferenciaMercadoSimulVen&quot; as decimal(26,8)) 	as &quot;DiferenciaMercadoSimulVen&quot;&#xD;
	--PRESTAMO &#xD;
