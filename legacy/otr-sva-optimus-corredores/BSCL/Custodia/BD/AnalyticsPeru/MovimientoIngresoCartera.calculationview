      <calculatedViewAttributes/>
      <definition> 
 /********* Begin Procedure Script ************/ 
 BEGIN 
 	 var_out = select car.&quot;IdEmpresa&quot;
					, empre.&quot;Nombre&quot; as &quot;NombreEmpresa&quot;
		  			, car.&quot;IdCartera&quot; as &quot;IdCartera&quot;
					, car.&quot;FechaIngresoRegistro&quot; as &quot;FechaRegistro&quot;
					, car.&quot;INGFechaOperacion&quot; as &quot;FechaOperacion&quot; 					
					, 'INGRESO' as &quot;TipoOperacion&quot; 					
					, car.&quot;IdCliente&quot; as &quot;IdCliente&quot; 						
					, car.&quot;IdPortafolio&quot; as &quot;IdPortafolio&quot; 					
						--, cli.&quot;RazonSocial&quot; as &quot;NombreCliente&quot;
					, PER.&quot;Nombres&quot; || ' ' || PER.&quot;ApellidoPaterno&quot; || ' ' || PER.&quot;ApellidoMaterno&quot;  AS &quot;NombreCliente&quot; 	
					, COALESCE(PER.&quot;RazonSocial&quot;,'')		AS &quot;RazonSocial&quot;
					, PER.&quot;Tipo&quot; 					 	AS &quot;TipoPersona&quot;
					, Cli.&quot;DocumentoIdentidadAdicional&quot;	AS &quot;Rut&quot;
					, DOC.&quot;IdTipoDocumentoIdentidadAsociado&quot;		AS &quot;TipoDocumento&quot;				
					, DOC.&quot;DocumentoIdentidadAsociado&quot; as &quot;DocumentoIdentidad&quot; 				
					, car.&quot;IdConcepto&quot; as &quot;IdConcepto&quot; 						
					, Concepto.&quot;Nombre&quot; as &quot;NombreConcepto&quot; 					
					, car.&quot;IdClasificacionTipoInstrumento&quot; as &quot;IdClasificacionTipoInstrumento&quot; 	
					, car.&quot;IdTipoInstrumento&quot; as &quot;IdTipoInstrumento&quot; 				
					, IFNULL(case
						when car.&quot;IdClasificacionTipoInstrumento&quot; = 'RE' then
							--(select distinct &quot;Nemotecnico&quot; from &quot;BSCL.Custodia.BD::CUS.Subyacente&quot; as Suby where (car.&quot;IdEmpresa&quot; = Suby.&quot;IdEmpresa&quot; and car.&quot;FolioCartera&quot; = Suby.&quot;FolioCarteraRelacionada&quot;))
							(select &quot;IdInstrumento&quot; 
							from (
									select &quot;IdInstrumento&quot;, row_number() over(order by (SELECT 1 from dummy) ) as &quot;NroFila&quot; 
									from &quot;BSCL.Custodia.BD::CUS.Subyacente&quot; as miSub
									where  car.&quot;FolioCartera&quot; = miSub.&quot;FolioCarteraRelacionada&quot;
								) as Suby
								where Suby.&quot;NroFila&quot; = 1
							)
						else car.&quot;IdInstrumento&quot;
					  end, 0 )	AS &quot;IdInstrumento&quot;
					, IFNULL(case
						when car.&quot;IdClasificacionTipoInstrumento&quot; = 'RE' then
							--(select distinct &quot;Nemotecnico&quot; from &quot;BSCL.Custodia.BD::CUS.Subyacente&quot; as Suby where (car.&quot;IdEmpresa&quot; = Suby.&quot;IdEmpresa&quot; and car.&quot;FolioCartera&quot; = Suby.&quot;FolioCarteraRelacionada&quot;))
							(select &quot;Nemotecnico&quot; 
							from (
									select &quot;Nemotecnico&quot;, row_number() over(order by (SELECT 1 from dummy) ) as &quot;NroFila&quot; 
									from &quot;BSCL.Custodia.BD::CUS.Subyacente&quot; as miSub
									where  car.&quot;FolioCartera&quot; = miSub.&quot;FolioCarteraRelacionada&quot;
								) as Suby
								where Suby.&quot;NroFila&quot; = 1
							)
						when car.&quot;IdClasificacionTipoInstrumento&quot; = 'IF' THEN car.&quot;NemoSVS&quot;
						else car.&quot;Nemotecnico&quot;
					  end, '') AS &quot;Nemotecnico&quot;
					, car.&quot;IdEmisor&quot; as &quot;IdEmisor&quot; 						
					, car.&quot;FechaVencimientoInstrumento&quot; as &quot;FechaVencimientoInstr&quot; 			
					, car.&quot;INGFechaLiquidacion&quot; as &quot;FechaLiquidacion&quot; 				
					, car.&quot;IdTipoReajuste&quot; as &quot;IdTipoReajuste&quot; 					
					, car.&quot;NemoSVS&quot; as &quot;NemoSVS&quot; 							
					, car.&quot;IdMonedaInstrumento&quot; as &quot;IdMonedaInstr&quot; 					
					, car.&quot;IdBoveda&quot; as &quot;IdBoveda&quot; 						
					, car.&quot;Cantidad&quot; as &quot;Cantidad&quot; 						
					, car.&quot;PrecioCompra&quot; as &quot;Precio&quot;	 						
					, car.&quot;TasaCompra&quot; as &quot;Tasa&quot;		 						
					, car.&quot;MontoCompra&quot;as &quot;Monto&quot;	 						
					, car.&quot;ValorRescate&quot; as &quot;ValorRescate&quot;						
					, car.&quot;Cantidad&quot; as &quot;Saldo&quot; 							
					, car.&quot;FolioCartera&quot; as &quot;FolioCartera&quot;						
					, car.&quot;FolioComprobante&quot;
					, car.&quot;FechaComprobante&quot;
					, car.&quot;IdTipoComprobante&quot;
					,CASE WHEN car.&quot;IdMonedaInstrumento&quot; != car.&quot;IdMonedaSistema&quot; THEN
						CAST((car.&quot;MontoCompra&quot; / CASE WHEN car.&quot;MontoCompraMonedaInstrumento&quot; = 0 THEN 1 ELSE car.&quot;MontoCompraMonedaInstrumento&quot; END) AS DECIMAL(26,8))
					 ELSE CAST(0 AS DECIMAL(26,8))
					 END								AS &quot;TipoCambio&quot;
					from  &quot;BSCL.Custodia.BD.Vistas::CUS.ConsultarTablaCartera&quot; as car
					LEFT JOIN &quot;BSCL.Portafolio.BD.Vistas::ConsultarPortafolio&quot; as Port ON Port.&quot;IdPortafolio&quot; = car.&quot;IdPortafolio&quot; 
					LEFT JOIN &quot;BSCL.SocioNegocio.BD.Vistas::CLI.ConsultarCliente&quot; as Cli ON Cli.&quot;IdCliente&quot; = Port.&quot;IdCliente&quot; 
					LEFT JOIN &quot;BSCL.Plataforma.BD::PLA.Concepto&quot; as Concepto ON car.&quot;IdConcepto&quot; = Concepto.&quot;IdConcepto&quot;
					INNER JOIN &quot;BSCL.Plataforma.BD::PLA.Empresa&quot; as empre ON empre.&quot;IdEmpresa&quot; = car.&quot;IdEmpresa&quot;
					INNER JOIN &quot;BSCL.SocioNegocio.BD::PER.Persona&quot; AS PER
							ON PER.&quot;IdPersona&quot; = Cli.&quot;IdPersona&quot;
					INNER JOIN &quot;BSCL.SocioNegocio.BD::PER.DocumentoIdentidad&quot; AS DOC
							ON DOC.&quot;IdDocumentoIdentidad&quot; = PER.&quot;IdDocumentoIdentidad&quot;
					 ;

END /********* End Procedure Script ************/</definition>
