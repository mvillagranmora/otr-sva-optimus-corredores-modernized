<?xml version="1.0" encoding="UTF-8"?>
<Calculation:scenario xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Calculation="http://www.sap.com/ndb/BiModelCalculation.ecore" schemaVersion="2.3" id="MovimientoCartera" applyPrivilegeType="ANALYTIC_PRIVILEGE" checkAnalyticPrivileges="true" defaultClient="$$client$$" defaultLanguage="$$language$$" hierarchiesSQLEnabled="false" translationRelevant="true" visibility="internal" calculationScenarioType="SCRIPT_BASED" dataCategory="DEFAULT" enforceSqlExecution="false" executionSemantic="UNDEFINED" scriptParametersCaseSensitive="true">
  <descriptions defaultDescription="MovimientoCartera_"/>
  <defaultSchema schemaName="BSCL"/>
  <localVariables/>
  <variableMappings/>
  <informationModelLayout relativeWidthScenario="27"/>
  <dataSources/>
  <calculationViews>
    <calculationView xsi:type="Calculation:SqlScriptView" id="Script_View">
      <descriptions/>
      <viewAttributes>
        <viewAttribute datatype="BIGINT" id="IdEmpresa"/>
        <viewAttribute datatype="NVARCHAR" id="NombreEmpresa" length="100"/>
        <viewAttribute datatype="BIGINT" id="IdCartera"/>
        <viewAttribute datatype="CHAR" id="FechaOperacion" length="10"/>
        <viewAttribute datatype="CHAR" id="FechaRegistro" length="27"/>
        <viewAttribute datatype="NVARCHAR" id="TipoOperacion" length="10"/>
        <viewAttribute datatype="BIGINT" id="IdCliente"/>
        <viewAttribute datatype="NVARCHAR" id="NombreCliente" length="302"/>
        <viewAttribute datatype="VARCHAR" id="RazonSocial" length="100"/>
        <viewAttribute datatype="VARCHAR" id="TipoPersona" length="1"/>
        <viewAttribute datatype="NVARCHAR" id="Rut" length="40"/>
        <viewAttribute datatype="VARCHAR" id="TipoDocumento" length="3"/>
        <viewAttribute datatype="NVARCHAR" id="DocumentoIdentidad" length="40"/>
        <viewAttribute datatype="BIGINT" id="IdPortafolio"/>
        <viewAttribute datatype="NVARCHAR" id="CodigoPortafolio" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="IdConcepto" length="6"/>
        <viewAttribute datatype="NVARCHAR" id="NombreConcepto" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="IdClasificacionTipoInstrumento" length="3"/>
        <viewAttribute datatype="NVARCHAR" id="NombreClasificacionTipoInstrumento" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="IdTipoInstrumento" length="3"/>
        <viewAttribute datatype="NVARCHAR" id="NombreTipoInstrumento" length="100"/>
        <viewAttribute datatype="BIGINT" id="IdInstrumento"/>
        <viewAttribute datatype="NVARCHAR" id="Nemotecnico" length="40"/>
        <viewAttribute datatype="NVARCHAR" id="ISIN" length="40"/>
        <viewAttribute datatype="NVARCHAR" id="IdEmisor" length="40"/>
        <viewAttribute datatype="CHAR" id="FechaVencimientoInstrumento" length="10"/>
        <viewAttribute datatype="CHAR" id="FechaLiquidacion" length="10"/>
        <viewAttribute datatype="NVARCHAR" id="IdTipoReajuste" length="3"/>
        <viewAttribute datatype="NVARCHAR" id="IdMonedaInstrumento" length="3"/>
        <viewAttribute datatype="NVARCHAR" id="IdBoveda" length="3"/>
        <viewAttribute datatype="DECIMAL" id="Cantidad" length="26" scale="8"/>
        <viewAttribute datatype="DECIMAL" id="Precio" length="26" scale="8"/>
        <viewAttribute datatype="DECIMAL" id="Tasa" length="26" scale="8"/>
        <viewAttribute datatype="DECIMAL" id="Monto" length="26" scale="8"/>
        <viewAttribute datatype="DECIMAL" id="ValorRescate" length="26" scale="8"/>
        <viewAttribute datatype="DECIMAL" id="SaldoCartera" length="26" scale="8"/>
        <viewAttribute datatype="DECIMAL" id="FolioCartera" length="26" scale="8"/>
        <viewAttribute datatype="NVARCHAR" id="IdTipoComprobante" length="6"/>
        <viewAttribute datatype="BIGINT" id="FolioComprobante"/>
        <viewAttribute datatype="CHAR" id="FechaComprobante" length="10"/>
        <viewAttribute datatype="DECIMAL" id="TipoCambio" length="26" scale="8"/>
      </viewAttributes>
      <calculatedViewAttributes/>
      <definition> 
 /********* Begin Procedure Script ************/ 
 BEGIN      
 	 var_out =   SELECT car.&quot;IdEmpresa&quot;						as &quot;IdEmpresa&quot;
					,CAST( empre.&quot;Nombre&quot;  AS NVARCHAR(100)) as &quot;NombreEmpresa&quot;
					, car.&quot;IdCartera&quot; 						as &quot;IdCartera&quot;
					, LEFT(TO_VARCHAR(IFNULL(car.&quot;EGRFechaOperacion&quot;,'0001-01-01')),10) as &quot;FechaOperacion&quot;
					, CASE WHEN IFNULL(car.&quot;EGRFechaOperacion&quot;,'')= '' THEN '0001-01-01 00:00:00' 
						 	                              ELSE  
						 	                                  CASE WHEN  car.&quot;EGRFechaOperacion&quot; IN ('0001-01-01 00:00:00','1900-01-01 00:00:00.0') THEN '0001-01-01 00:00:00' 
						 	                                  	ELSE LEFT(TO_CHAR(ADD_SECONDS (car.&quot;EGRFechaOperacion&quot;, CONFIGURACION.&quot;Valor&quot;)),27)
						 	                                  END 
					END 									as &quot;FechaRegistro&quot;
					,CAST('RETIRO'  as NVARCHAR(10)) 		as &quot;TipoOperacion&quot; 					
					, CASE WHEN car.&quot;IdCliente&quot; = 0 THEN NULL ELSE car.&quot;IdCliente&quot; END as &quot;IdCliente&quot; 						
					, CAST((PER.&quot;Nombres&quot; || ' ' || PER.&quot;ApellidoPaterno&quot; || ' ' || PER.&quot;ApellidoMaterno&quot;) AS NVARCHAR(302)) AS &quot;NombreCliente&quot;
					, COALESCE(PER.&quot;RazonSocial&quot;,'')		AS &quot;RazonSocial&quot;
					, PER.&quot;Tipo&quot; 					 	AS &quot;TipoPersona&quot;
					, Cli.&quot;DocumentoIdentidadAdicional&quot;		AS &quot;Rut&quot;
					--, CAST(cli.&quot;RazonSocial&quot; AS NVARCHAR(302)) as &quot;NombreCliente&quot; 		
			        , DOC.&quot;IdTipoDocumentoIdentidadAsociado&quot;		AS &quot;TipoDocumento&quot;
					, CAST(DOC.&quot;DocumentoIdentidadAsociado&quot; AS NVARCHAR(40)) as &quot;DocumentoIdentidad&quot; 				
					, CASE WHEN car.&quot;IdPortafolio&quot; = 0 THEN NULL ELSE car.&quot;IdPortafolio&quot; END as &quot;IdPortafolio&quot;
					, CAST(Port.&quot;CodigoPortafolio&quot; AS NVARCHAR(100)) as &quot;CodigoPortafolio&quot;	
					, CASE WHEN car.&quot;EGRIdConcepto&quot; = '' THEN NULL ELSE car.&quot;EGRIdConcepto&quot; END as &quot;IdConcepto&quot; 
					, CAST(COALESCE(Concepto.&quot;Nombre&quot;,'') AS NVARCHAR(100)) as &quot;NombreConcepto&quot;
					, CASE WHEN car.&quot;IdClasificacionTipoInstrumento&quot; = '' THEN NULL ELSE car.&quot;IdClasificacionTipoInstrumento&quot; END  as &quot;IdClasificacionTipoInstrumento&quot;
					, CAST(COALESCE(ClasInst.&quot;Nombre&quot;,'') AS NVARCHAR(100)) as &quot;NombreClasificacionTipoInstrumento&quot;
					, CASE WHEN car.&quot;IdTipoInstrumento&quot; = '' THEN NULL ELSE car.&quot;IdTipoInstrumento&quot; END as &quot;IdTipoInstrumento&quot;
					, CAST(COALESCE(TipIns.&quot;Nombre&quot;,'') AS NVARCHAR(100)) as &quot;NombreTipoInstrumento&quot;
					, COALESCE(Primer_Subyacente.&quot;IdInstrumento&quot;,car.&quot;IdInstrumento&quot;)  as &quot;IdInstrumento&quot;
					, CASE WHEN COALESCE(car.&quot;IdClasificacionTipoInstrumento&quot;,'') = 'IF' THEN CAST(car.&quot;NemoSVS&quot; AS NVARCHAR(40)) 
					      ELSE CAST(COALESCE(Primer_Subyacente.&quot;Nemotecnico&quot;,car.&quot;Nemotecnico&quot;) AS NVARCHAR(40))  
					  END as &quot;Nemotecnico&quot;
					, CAST(Instrumento.&quot;ISIN&quot; AS NVARCHAR(40)) as &quot;ISIN&quot;
					, CASE WHEN car.&quot;IdEmisor&quot; = '' THEN NULL ELSE CAST(car.&quot;IdEmisor&quot; AS NVARCHAR(40)) END as &quot;IdEmisor&quot; 						
					, LEFT(TO_CHAR(IFNULL(car.&quot;FechaVencimientoInstrumento&quot;,'0001-01-01')),10) as &quot;FechaVencimientoInstrumento&quot; 			
					, LEFT(TO_CHAR(IFNULL(car.&quot;EGRFechaLiquidacion&quot;,'0001-01-01')),10) as &quot;FechaLiquidacion&quot; 				
					, CASE WHEN car.&quot;IdTipoReajuste&quot; = '' THEN NULL ELSE car.&quot;IdTipoReajuste&quot; END as &quot;IdTipoReajuste&quot; 												
					, CASE WHEN car.&quot;IdMonedaInstrumento&quot; = '' THEN NULL ELSE car.&quot;IdMonedaInstrumento&quot; END as &quot;IdMonedaInstrumento&quot; 					
					, CASE WHEN car.&quot;IdBoveda&quot; = '' THEN NULL ELSE car.&quot;IdBoveda&quot; END as &quot;IdBoveda&quot; 						
					, car.&quot;EGRCantidad&quot; 					as &quot;Cantidad&quot; 						
					, car.&quot;EGRPrecio&quot; 						as &quot;Precio&quot;	 						
					, car.&quot;EGRTasa&quot; 						as &quot;Tasa&quot;		 						
					, car.&quot;EGRMonto&quot;						as &quot;Monto&quot;	 						
					, car.&quot;EGRValorRescate&quot; 				as &quot;ValorRescate&quot;						
					, cast((car.&quot;INGCantidad&quot; - &quot;EGRCantidad&quot;) as DECIMAL(26,8)) as &quot;SaldoCartera&quot; 							
					, car.&quot;FolioCartera&quot; 					as &quot;FolioCartera&quot;						
					, CASE WHEN car.&quot;EGRIdTipoComprobante&quot; = '' THEN NULL ELSE car.&quot;EGRIdTipoComprobante&quot; END as &quot;IdTipoComprobante&quot;
					, car.&quot;EGRFolioComprobante&quot; 			as &quot;FolioComprobante&quot;
					, LEFT(TO_CHAR(IFNULL(car.&quot;EGRFechaComprobante&quot;,'0001-01-01')),10) as &quot;FechaComprobante&quot;
					, CASE WHEN car.&quot;IdMonedaInstrumento&quot; != car.&quot;IdMonedaSistema&quot; THEN
						CAST((car.&quot;MontoCompra&quot; / CASE WHEN car.&quot;MontoCompraMonedaInstrumento&quot; = 0 THEN 1 ELSE car.&quot;MontoCompraMonedaInstrumento&quot; END) AS DECIMAL(26,8))
					  ELSE 0
					  END								AS &quot;TipoCambio&quot;
					
					
					
					--, DOC.&quot;DocumentoIdentidad&quot;			AS &quot;NumeroDocumento&quot;
					
					from &quot;BSCL.Custodia.BD.Vistas::CUS.ConsultarTablaCartera&quot; as car
					INNER JOIN (select a1.&quot;IdCartera&quot;,a1.&quot;FolioCartera&quot; from (			       		 
																	select	 
																			RANK() over (partition by  &quot;FolioCartera&quot; order by &quot;IdCartera&quot; ASC) as RANK
																			,&quot;IdCartera&quot; ,&quot;FolioCartera&quot; from BSCL.&quot;BSCL.Custodia.BD.Vistas::CUS.ConsultarTablaCartera&quot;
																 	) as a1
												 					where &quot;RANK&quot; = 1
					 					) AS Primer_cartera
						ON Primer_cartera.&quot;IdCartera&quot; = car.&quot;IdCartera&quot;
					INNER JOIN &quot;BSCL.Plataforma.BD::PLA.Empresa&quot; as empre ON empre.&quot;IdEmpresa&quot; = car.&quot;IdEmpresa&quot;
					CROSS JOIN (select top 1 &quot;Valor&quot; from &quot;BSCL&quot;.&quot;BSCL.Plataforma.BD::PLA.Configuracion&quot;
				            where &quot;CodigoParametro&quot; = 'PLA.SegundosZonaHoraria') AS CONFIGURACION 
					LEFT JOIN &quot;BSCL.Portafolio.BD.Vistas::ConsultarPortafolio&quot; as Port ON Port.&quot;IdPortafolio&quot; = car.&quot;IdPortafolio&quot; 
					LEFT JOIN &quot;BSCL.SocioNegocio.BD.Vistas::CLI.ConsultarCliente&quot; as Cli ON Cli.&quot;IdCliente&quot; = Port.&quot;IdCliente&quot; 
					LEFT JOIN &quot;BSCL.Plataforma.BD::PLA.Concepto&quot; as Concepto ON car.&quot;EGRIdConcepto&quot; = Concepto.&quot;IdConcepto&quot; 
					LEFT JOIN &quot;BSCL.Plataforma.BD::INS.ClasificacionTipoInstrumento&quot; as ClasInst ON ClasInst.&quot;IdClasificacionTipoInstrumento&quot; = car.&quot;IdClasificacionTipoInstrumento&quot; 
					LEFT JOIN &quot;BSCL.Plataforma.BD::INS.TipoInstrumento&quot; as TipIns ON TipIns.&quot;IdTipoInstrumento&quot; = car.&quot;IdTipoInstrumento&quot; 
					LEFT JOIN &quot;BSCL.Plataforma.BD::INS.Instrumento&quot; as Instrumento ON Instrumento.&quot;IdInstrumento&quot; = car.&quot;IdInstrumento&quot;
					LEFT JOIN (select a1.&quot;FolioCarteraRelacionada&quot;,a1.&quot;IdSubyacente&quot;, a1.&quot;Nemotecnico&quot;,a1.&quot;IdInstrumento&quot; from (			       		 
																	select	 
																			RANK() over (partition by  &quot;FolioCarteraRelacionada&quot; order by &quot;IdSubyacente&quot; ASC) as RANK
																			,&quot;IdSubyacente&quot;
																			,&quot;FolioCarteraRelacionada&quot;
																			,&quot;IdInstrumento&quot;
																			,&quot;Nemotecnico&quot;
																			 from BSCL.&quot;BSCL.Custodia.BD::CUS.Subyacente&quot;
																 	        
																 	) as a1
												 					where &quot;RANK&quot; = 1
					 					) AS Primer_Subyacente
						ON Primer_Subyacente.&quot;FolioCarteraRelacionada&quot; = Primer_cartera.&quot;FolioCartera&quot;
					INNER JOIN &quot;BSCL.SocioNegocio.BD::PER.Persona&quot; AS PER
							ON PER.&quot;IdPersona&quot; = Cli.&quot;IdPersona&quot;
					INNER JOIN &quot;BSCL.SocioNegocio.BD::PER.DocumentoIdentidad&quot; AS DOC
							ON DOC.&quot;IdDocumentoIdentidad&quot; = PER.&quot;IdDocumentoIdentidad&quot;
					WHERE car.&quot;EGRCantidad&quot; &lt;> 0
					  AND car.&quot;IdEstado&quot; &lt;> 'ANU'
					union all							
					SELECT car.&quot;IdEmpresa&quot;
						, CAST(empre.&quot;Nombre&quot; AS NVARCHAR(100)) as &quot;NombreEmpresa&quot; 
						, car.&quot;IdCartera&quot; as &quot;IdCartera&quot;
						, LEFT(TO_CHAR(IFNULL(car.&quot;INGFechaOperacion&quot;,'0001-01-01')),10)   as &quot;FechaOperacion&quot;-- REVISAR
						,CASE WHEN IFNULL(car.&quot;INGFechaOperacion&quot; ,'')= '' THEN '0001-01-01 00:00:00' 
					 	                              ELSE  
					 	                                  CASE WHEN  car.&quot;INGFechaOperacion&quot;  IN ('0001-01-01 00:00:00','1900-01-01 00:00:00.0') THEN '0001-01-01 00:00:00' 
					 	                                  	ELSE LEFT(TO_CHAR(ADD_SECONDS (car.&quot;INGFechaOperacion&quot; , CONFIGURACION.&quot;Valor&quot;)),27)
					 	                                  END 
						 END as &quot;FechaRegistro&quot;
						, CAST('INGRESO' AS NVARCHAR(10)) as &quot;TipoOperacion&quot;
						, CASE WHEN car.&quot;IdCliente&quot; = 0 THEN NULL ELSE car.&quot;IdCliente&quot; END as &quot;IdCliente&quot;
						, CAST((PER.&quot;Nombres&quot; || ' ' || PER.&quot;ApellidoPaterno&quot; || ' ' || PER.&quot;ApellidoMaterno&quot;) AS NVARCHAR(302)) AS &quot;NombreCliente&quot;
						, COALESCE(PER.&quot;RazonSocial&quot;,'')		AS &quot;RazonSocial&quot;
						, PER.&quot;Tipo&quot; 					 	AS &quot;TipoPersona&quot;
						, Cli.&quot;DocumentoIdentidadAdicional&quot;		AS &quot;Rut&quot;
						--, CAST(cli.&quot;RazonSocial&quot; AS NVARCHAR(302)) as &quot;NombreCliente&quot;
						, DOC.&quot;IdTipoDocumentoIdentidadAsociado&quot;		AS &quot;TipoDocumento&quot;
						, CAST(DOC.&quot;DocumentoIdentidadAsociado&quot; AS NVARCHAR(40)) as &quot;DocumentoIdentidad&quot;
						, CASE WHEN car.&quot;IdPortafolio&quot; = 0 THEN NULL ELSE car.&quot;IdPortafolio&quot; END as &quot;IdPortafolio&quot;
						, CAST(Port.&quot;CodigoPortafolio&quot; AS NVARCHAR(100)) as &quot;CodigoPortafolio&quot;
						, CASE WHEN car.&quot;IdConcepto&quot; = '' THEN NULL ELSE car.&quot;IdConcepto&quot; END as &quot;IdConcepto&quot;
						, CAST(COALESCE(Concepto.&quot;Nombre&quot;,'') AS NVARCHAR(100)) as &quot;NombreConcepto&quot;
						, CASE WHEN car.&quot;IdClasificacionTipoInstrumento&quot; = '' THEN NULL ELSE car.&quot;IdClasificacionTipoInstrumento&quot; END as &quot;IdClasificacionTipoInstrumento&quot;
						, CAST(COALESCE(ClasInst.&quot;Nombre&quot;,'') AS NVARCHAR(100)) as &quot;NombreClasificacionTipoInstrumento&quot;
						, CASE WHEN car.&quot;IdTipoInstrumento&quot; = '' THEN NULL ELSE car.&quot;IdTipoInstrumento&quot; END as &quot;IdTipoInstrumento&quot;
						, CAST(COALESCE(TipIns.&quot;Nombre&quot;,'') AS NVARCHAR(100)) as &quot;NombreTipoInstrumento&quot;
						, COALESCE(Primer_Subyacente.&quot;IdInstrumento&quot;,car.&quot;IdInstrumento&quot;)  as &quot;IdInstrumento&quot;
						, CASE WHEN COALESCE(car.&quot;IdClasificacionTipoInstrumento&quot;,'') = 'IF' THEN CAST(car.&quot;NemoSVS&quot; AS NVARCHAR(40)) 
				      		ELSE CAST(COALESCE(Primer_Subyacente.&quot;Nemotecnico&quot;,car.&quot;Nemotecnico&quot;) AS NVARCHAR(40))  
				 		  END as &quot;Nemotecnico&quot; 
						, CAST(Instrumento.&quot;ISIN&quot; AS NVARCHAR(40))as &quot;ISIN&quot;
						, CASE WHEN car.&quot;IdEmisor&quot; = '' THEN NULL ELSE CAST(car.&quot;IdEmisor&quot; AS NVARCHAR(40)) END as &quot;IdEmisor&quot;
						, LEFT(TO_CHAR(IFNULL(car.&quot;FechaVencimientoInstrumento&quot;,'0001-01-01')),10)  as &quot;FechaVencimientoInstrumento&quot;
						, LEFT(TO_CHAR(IFNULL(car.&quot;INGFechaLiquidacion&quot;,'0001-01-01')),10)  as &quot;FechaLiquidacion&quot;
						, CASE WHEN car.&quot;IdTipoReajuste&quot; = '' THEN NULL ELSE car.&quot;IdTipoReajuste&quot; END as &quot;IdTipoReajuste&quot;
						, CASE WHEN car.&quot;IdMonedaInstrumento&quot; = '' THEN NULL ELSE car.&quot;IdMonedaInstrumento&quot; END as &quot;IdMonedaInstrumento&quot; 
						, CASE WHEN car.&quot;IdBoveda&quot; = '' THEN NULL ELSE car.&quot;IdBoveda&quot; END as &quot;IdBoveda&quot;
						, car.&quot;Cantidad&quot; as &quot;Cantidad&quot;
						, car.&quot;PrecioCompra&quot; as &quot;Precio&quot;
						, car.&quot;TasaCompra&quot; as &quot;Tasa&quot;
						, car.&quot;MontoCompra&quot;as &quot;Monto&quot;
						, car.&quot;ValorRescate&quot; as &quot;ValorRescate&quot;
						, car.&quot;Cantidad&quot; as &quot;Saldo&quot;
						, car.&quot;FolioCartera&quot; as &quot;FolioCartera&quot;
						, CASE WHEN car.&quot;IdTipoComprobante&quot; = '' THEN NULL ELSE car.&quot;IdTipoComprobante&quot; END AS &quot;IdTipoComprobante&quot;  
						, car.&quot;FolioComprobante&quot;
						, LEFT(TO_CHAR(IFNULL(car.&quot;FechaComprobante&quot;,'0001-01-01')),10) as &quot;FechaComprobante&quot;
						, CASE WHEN car.&quot;IdMonedaInstrumento&quot; != car.&quot;IdMonedaSistema&quot; THEN
							CAST((car.&quot;MontoCompra&quot; / CASE WHEN car.&quot;MontoCompraMonedaInstrumento&quot; = 0 THEN 1 ELSE car.&quot;MontoCompraMonedaInstrumento&quot; END) AS DECIMAL(26,8))
						  ELSE 0
						  END								AS &quot;TipoCambio&quot;
						
						from &quot;BSCL.Custodia.BD.Vistas::CUS.ConsultarTablaCartera&quot; as car 
						INNER JOIN (select a1.&quot;IdCartera&quot;,a1.&quot;FolioCartera&quot; from (			       		 
																select	 
																		RANK() over (partition by  &quot;FolioCartera&quot; order by &quot;IdCartera&quot; ASC) as RANK
																		,&quot;IdCartera&quot; ,&quot;FolioCartera&quot; from BSCL.&quot;BSCL.Custodia.BD.Vistas::CUS.ConsultarTablaCartera&quot;
															 	) as a1
											 					where &quot;RANK&quot; = 1
				 					) AS Primer_cartera
				 		 ON Primer_cartera.&quot;IdCartera&quot; = car.&quot;IdCartera&quot;	
						 INNER JOIN &quot;BSCL.Plataforma.BD::PLA.Empresa&quot; as empre ON empre.&quot;IdEmpresa&quot; = car.&quot;IdEmpresa&quot;
						 CROSS JOIN (select top 1 &quot;Valor&quot; from &quot;BSCL&quot;.&quot;BSCL.Plataforma.BD::PLA.Configuracion&quot;
				        	where &quot;CodigoParametro&quot; = 'PLA.SegundosZonaHoraria') AS CONFIGURACION 
						 LEFT JOIN &quot;BSCL.Portafolio.BD.Vistas::ConsultarPortafolio&quot; as Port ON Port.&quot;IdPortafolio&quot; = car.&quot;IdPortafolio&quot; 
						 LEFT JOIN &quot;BSCL.SocioNegocio.BD.Vistas::CLI.ConsultarCliente&quot; as Cli ON Cli.&quot;IdCliente&quot; = Port.&quot;IdCliente&quot; 
						 LEFT JOIN &quot;BSCL.Plataforma.BD::PLA.Concepto&quot; as Concepto ON car.&quot;EGRIdConcepto&quot; = Concepto.&quot;IdConcepto&quot; 
						 LEFT JOIN &quot;BSCL.Plataforma.BD::INS.ClasificacionTipoInstrumento&quot; as ClasInst ON ClasInst.&quot;IdClasificacionTipoInstrumento&quot; = car.&quot;IdClasificacionTipoInstrumento&quot; 
						 LEFT JOIN &quot;BSCL.Plataforma.BD::INS.TipoInstrumento&quot; as TipIns ON TipIns.&quot;IdTipoInstrumento&quot; = car.&quot;IdTipoInstrumento&quot; 
						 LEFT JOIN &quot;BSCL.Plataforma.BD::INS.Instrumento&quot; as Instrumento ON Instrumento.&quot;IdInstrumento&quot; = car.&quot;IdInstrumento&quot;
						 LEFT JOIN (select a1.&quot;FolioCarteraRelacionada&quot;,a1.&quot;IdSubyacente&quot;, a1.&quot;Nemotecnico&quot;,a1.&quot;IdInstrumento&quot; from (			       		 
																select	 
																		RANK() over (partition by  &quot;FolioCarteraRelacionada&quot; order by &quot;IdSubyacente&quot; ASC) as RANK
																		,&quot;IdSubyacente&quot;
																		,&quot;FolioCarteraRelacionada&quot;
																		,&quot;IdInstrumento&quot;
																		,&quot;Nemotecnico&quot;
																		 from BSCL.&quot;BSCL.Custodia.BD::CUS.Subyacente&quot;
															 	        
															 	) as a1
											 					where &quot;RANK&quot; = 1
				 					) AS Primer_Subyacente
				 		 on Primer_Subyacente.&quot;FolioCarteraRelacionada&quot; = Primer_cartera.&quot;FolioCartera&quot;
				 		 INNER JOIN &quot;BSCL.SocioNegocio.BD::PER.Persona&quot; AS PER ON PER.&quot;IdPersona&quot; = Cli.&quot;IdPersona&quot;
						 INNER JOIN &quot;BSCL.SocioNegocio.BD::PER.DocumentoIdentidad&quot; AS DOC ON DOC.&quot;IdDocumentoIdentidad&quot; = PER.&quot;IdDocumentoIdentidad&quot;
				 		 WHERE car.&quot;IdEstado&quot; &lt;> 'ANU';

END /********* End Procedure Script ************/</definition>
    </calculationView>
  </calculationViews>
  <logicalModel id="Script_View">
    <descriptions/>
    <attributes>
      <attribute id="IdEmpresa" order="1">
        <descriptions defaultDescription="IdEmpresa"/>
        <keyMapping columnObjectName="Script_View" columnName="IdEmpresa"/>
      </attribute>
