						,&quot;MontoMatriz&quot;
			FROM  
            (SELECT 
 	                 RANK() over (partition by car.&quot;IdEmpresa&quot;, car.&quot;FolioCartera&quot;, car.&quot;INGFechaLiquidacion&quot; order by CAR.&quot;IdCartera&quot; desc) as RANK 
