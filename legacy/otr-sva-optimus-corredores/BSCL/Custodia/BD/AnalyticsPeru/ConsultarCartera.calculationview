 /********* Begin Procedure Script ************/ 
 BEGIN 
 	 var_out =  SELECT  
  car.&quot;IdCartera&quot;  
  ,car.&quot;FolioCartera&quot;
  , car.&quot;FolioCarteraRelacionada&quot;
  , car.&quot;FechaOperacion&quot;
  , car.&quot;FechaIngresoRegistro&quot;
  , car.&quot;FechaLiquidacion&quot;
  , DOC.&quot;DocumentoIdentidad&quot;
      -- PORTAFOLIO
  , Port.&quot;CodigoPortafolio&quot;
  , Port.&quot;DescripcionPortafolio&quot;
  , car.&quot;IdClasificacionTipoInstrumento&quot;    
  , TipoInstrumento.&quot;Descripcion&quot; AS &quot;TipoInstrumento&quot;    
  , ClasInst.&quot;Nombre&quot; as &quot;ClasificacionTipoInstrumento&quot;
  , car.&quot;IdTipoInstrumento&quot;
  ,case 
    when car.&quot;IdTipoInstrumento&quot; = 'SIM' or car.&quot;IdTipoInstrumento&quot; = 'PRT' or car.&quot;IdTipoInstrumento&quot; = 'EMP' then
      --(select distinct &quot;Nemotecnico&quot; from &quot;BSCL.Custodia.BD::CUS.Subyacente&quot; as Suby where (car.&quot;IdEmpresa&quot; = Suby.&quot;IdEmpresa&quot; and car.&quot;FolioCartera&quot; = Suby.&quot;FolioCarteraRelacionada&quot;))
      (select &quot;Nemotecnico&quot; 
      from (
          select &quot;Nemotecnico&quot;, row_number() over(order by (SELECT 1 from dummy) ) as &quot;NroFila&quot; 
          from bscl.&quot;BSCL.Custodia.BD::CUS.Subyacente&quot; as miSub
          where car.&quot;FolioCartera&quot; = miSub.&quot;FolioCarteraRelacionada&quot;
         ) as Suby
      where Suby.&quot;NroFila&quot; = 1
      )
    else car.&quot;Nemotecnico&quot;
  end as &quot;Nemotecnico&quot;  
  , car.&quot;FechaVencimientoOperacion&quot;
  , car.&quot;IdBoveda&quot;
  , car.&quot;INGCantidad&quot;
  , car.&quot;INGPrecioCompra&quot;  
  , car.&quot;TasaCompra&quot;
  , car.&quot;INGMontoATasaCompraActual&quot;  
  , car.&quot;INGPrecioMercadoActual&quot;
  , car.&quot;INGTasaMercadoActual&quot;
  , car.&quot;INGMontoATasaMercadoActual&quot;
  , car.&quot;INGPrecioPromedioCompra&quot;
  , car.&quot;INGMontoPrecioPromedioCompra&quot;    
  , (car.&quot;INGMontoATasaCompraActual&quot; - car.&quot;INGMontoATasaMercadoActual&quot;) as &quot;DiferenciaInversion&quot;
  , car.&quot;IdMonedaInstrumento&quot;      
  , car.&quot;EsFungible&quot;
  , car.&quot;IdConcepto&quot;
  , Concepto.&quot;Nombre&quot; as &quot;NombreConcepto&quot;  
  , car.&quot;CodigoIFRS&quot;    
  , car.&quot;NemoSVS&quot;
  , car.&quot;IdTipoComprobante&quot;
  , car.&quot;FolioComprobante&quot;
  , car.&quot;FechaComprobante&quot;
  , car.&quot;INGFechaCorteCupon&quot;
  , car.&quot;INGMontoCorteCupon&quot;
  , car.&quot;INGMontoCapitalCorteCupon&quot;
  , car.&quot;INGMontoInteresCorteCupon&quot;
  -- aqui nuevos agregados
  , car.&quot;IdCliente&quot;
  , car.&quot;IdPortafolio&quot;
  , car.&quot;IdEmisor&quot;
  , car.&quot;INGTasaCorredora&quot;
  , car.&quot;INGMontoATasaCorredora&quot;
  , car.&quot;ValorRescate&quot;
  , car.&quot;FechaVencimientoInstrumento&quot;
  , car.&quot;PlazoEnDiasOperacion&quot;
  , car.&quot;INGDurationCompraProximo&quot;
  , car.&quot;INGConvexidadCompraProximo&quot;
  , car.&quot;INGIdMonedaPagoCupon&quot;
  , car.&quot;INGFechaPagoCorteCupon&quot;
  , car.&quot;FechaEmisionInstrumento&quot;
  , car.&quot;IdOperacion&quot;
  , car.&quot;CorteMinimo&quot;
  , coalesce(Instrumento.&quot;ValorClasificacionRiesgo&quot;,'') as &quot;ValorClasificacionRiesgo&quot;
  , car.&quot;IdTipoProducto&quot;
  , coalesce(CusOperacion.&quot;IdMonedaPrincipal&quot;,'') as &quot;IdMonedaPrincipal&quot;
  , coalesce(CusOperacion.&quot;IdMonedaSecundaria&quot;,'') as &quot;IdMonedaSecundaria&quot;
  , coalesce(car.&quot;MontoMonedaPrincipal&quot;,0) as &quot;MontoMonedaPrincipal&quot; 
  , coalesce(car.&quot;MontoMonedaSecundaria&quot;,0) as &quot;MontoMonedaSecundaria&quot;
  , coalesce(car.&quot;ValorParidadCierre&quot;,0) as &quot;ValorParidadCierre&quot;
  , coalesce(ModalidadCumplimiento.&quot;ValorParametro&quot;,'') as &quot;ModalidadCumplimiento&quot;
  , coalesce(car.&quot;EGRIdTipoOperacion&quot;,'') as &quot;TipoOperacionDeSalidaCartera&quot;
  , car.&quot;EGRFechaLiquidacion&quot; as &quot;FechaLiquidacionSalida&quot;
  , car.&quot;EGRFechaOperacion&quot; 
  FROM bscl.&quot;BSCL.Custodia.BD::CUS.Cartera&quot; AS car -- select *  from bscl.&quot;BSCL.Custodia.BD::CUS.Cartera&quot;
  LEFT JOIN bscl.&quot;BSCL.Portafolio.BD::POR.Portafolio&quot; as Port ON Port.&quot;IdPortafolio&quot; = car.&quot;IdPortafolio&quot;
  -- Agregar persona Join Cliente/Persona
  LEFT JOIN bscl.&quot;BSCL.SocioNegocio.BD::CLI.Cliente&quot; as Cli ON Cli.&quot;IdCliente&quot; = Port.&quot;IdCliente&quot; 
  LEFT JOIN bscl.&quot;BSCL.SocioNegocio.BD::PER.Persona&quot; as PER ON PER.&quot;IdPersona&quot; = Cli.&quot;IdPersona&quot; 
  LEFT JOIN bscl.&quot;BSCL.SocioNegocio.BD::PER.DocumentoIdentidad&quot; as DOC ON DOC.&quot;IdPersona&quot; = Per.&quot;IdPersona&quot; 
    
  -- Eliminar, solo sacar IdTipoOperacion
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::INS.TipoOperacion&quot; as TipoOperacion ON car.&quot;IdTipoOperacion&quot; = TipoOperacion.&quot;IdTipoOperacion&quot; 
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::PLA.Empresa&quot; as Empresa ON car.&quot;IdEmpresa&quot; = Empresa.&quot;IdEmpresa&quot; 
    
  -- Usadas para sacar descripción
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::PLA.Boveda&quot;               as Boveda ON car.&quot;IdBoveda&quot; = Boveda.&quot;IdBoveda&quot; 
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::PLA.TipoReajuste&quot;             as TipoReajuste ON car.&quot;IdTipoReajuste&quot; = TipoReajuste.&quot;IdTipoReajuste&quot;   
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::INS.Bolsa&quot;                 as Bolsa ON car.&quot;IdBolsa&quot; = Bolsa.&quot;IdBolsa&quot; 
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::PLA.CondicionDeLiquidacion&quot;       as CondicionLiquidacion ON car.&quot;IdCondicionLiquidacion&quot; = CondicionLiquidacion.&quot;IdCondicionDeLiquidacion&quot; 
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::INS.Instrumento&quot;             as Instrumento ON car.&quot;IdInstrumento&quot; = Instrumento.&quot;IdInstrumento&quot;
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::INS.TipoInstrumento&quot;           as TipoInstrumento ON TipoInstrumento.&quot;IdTipoInstrumento&quot; = Instrumento.&quot;IdTipoInstrumento&quot; 
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::INS.ClasificacionTipoInstrumento&quot;     as ClasInst ON ClasInst.&quot;IdClasificacionTipoInstrumento&quot; = TipoInstrumento.&quot;IdClasificacionTipoInstrumento&quot; 
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::PLA.Moneda&quot;               as Mon1 ON car.&quot;IdMonedaSistema&quot; = Mon1.&quot;IdMoneda&quot; 
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::PLA.Moneda&quot;               as Mon2 ON car.&quot;IdMonedaInstrumento&quot; = Mon2.&quot;IdMoneda&quot; 
      
  -- tipos relevantes para la salida, porque es complejo o no hay vista que lo contenga
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::PLA.Concepto&quot;             as Concepto ON car.&quot;IdConcepto&quot; = Concepto.&quot;IdConcepto&quot; 
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::PLA.Concepto&quot;             as ConceptoEGR ON car.&quot;EGRIdConcepto&quot; = ConceptoEGR.&quot;IdConcepto&quot; 
  LEFT JOIN bscl.&quot;BSCL.Plataforma.BD::ACC.Usuario&quot;             as Usuario ON car.&quot;IdUsuario&quot; = Usuario.&quot;IdUsuario&quot; 
  LEFT JOIN bscl.&quot;BSCL.Custodia.BD.Vistas::PRT.ConsultarTipoPrestamo&quot;     as tpres on tpres.&quot;IdInstrumentoPrestamo&quot; = car.&quot;IdInstrumento&quot;
  LEFT JOIN bscl.&quot;BSCL.Mesa.BD::MES.Operacion&quot; as CusOperacion on CusOperacion.&quot;IdOperacion&quot; = car.&quot;IdOperacion&quot; 
  LEFT JOIN bscl.&quot;BSCL.Mesa.BD::MES.Parametro&quot; as ModalidadCumplimiento on  ModalidadCumplimiento.&quot;NombreTipoParametro&quot; = 'ModalidadLiquidacion' and ModalidadCumplimiento.&quot;IdParametro&quot; = CusOperacion.&quot;IdModalidadLiquidacion&quot;;
  
END /********* End Procedure Script ************/</definition>
