/********* Begin Procedure Script ************/ 
BEGIN 

	 /********************************
	 * DEFINICION VARIABLES
	 ********************************/
	 --CONSTANTES
	 declare idempresa 			bigint:=1;
	 declare fechaconsulta 		nvarchar(10):='0001-01-01';

	/********************************
	 * ASIGNACION DE LOS DATOS
	 ********************************/
	 var_parms = select
 		conf.&quot;IdEmpresa&quot; as idempresa,
 		conf.&quot;Valor&quot; as fechaconsulta
 	 from &quot;BSCL.Plataforma.BD::PLA.Configuracion&quot; conf 
 	 where conf.&quot;CodigoParametro&quot;='PLA.FechaSistema' 
 	 and conf.&quot;IdEmpresa&quot;= 1;
 	 
 	 select top 1 idempresa,fechaconsulta
 	 into idempresa,fechaconsulta
 	 from :var_parms;
 		
	 var_out = 
		SELECT 
	   	&quot;IdEjecutivo&quot;
	   	,&quot;NombreEjecutivo&quot;
		,&quot;CodigoSucursal&quot;
 		,&quot;NombreSucursal&quot;
		,&quot;IdCuentaInversion&quot; 
        ,&quot;CodigoCuentaInversion&quot;
        ,&quot;IdCliente&quot;
        ,&quot;NombreCliente&quot;
        ,&quot;DocumentoIdentidad&quot;
        ,&quot;IdPortafolio&quot;
        ,&quot;NombrePortafolio&quot;
        ,&quot;PropositoPortafolio&quot;
        ,&quot;CodigoPortafolio&quot;
        ,&quot;FechaSaldo&quot;
        ,&quot;IdMoneda&quot;
        ,&quot;CodigoMoneda&quot;
        ,&quot;NombreMoneda&quot;
        ,&quot;SaldoDisponible&quot;
        ,&quot;SaldoEnGarantia&quot;
        ,&quot;SaldoAPlazo&quot;
        ,&quot;SaldoRetiro&quot;
        ,&quot;SaldoRetenido&quot;
        ,&quot;Producto&quot;
        ,&quot;IdMatrizAgrupador&quot;
        ,&quot;EsADC&quot;
  FROM &quot;BSCL.CuentaInversion.BD.Vistas::ConsultarSaldoCuentaInversionAnalitica&quot; (
    PLACEHOLDER.&quot;$$p_idempresa$$&quot; => :idempresa,
 	PLACEHOLDER.&quot;$$p_fechaconsulta$$&quot; => :fechaconsulta,
 	PLACEHOLDER.&quot;$$p_idproductoagrupador$$&quot; => null,
 	PLACEHOLDER.&quot;$$p_solosaldonegativo$$&quot; => 'N',
 	PLACEHOLDER.&quot;$$p_solosaldodisponible$$&quot; => 'N',
 	PLACEHOLDER.&quot;$$p_incluyecargospendientes$$&quot; => 'N',
 	PLACEHOLDER.&quot;$$p_incluyeabonospendientes$$&quot; => 'N',
 	PLACEHOLDER.&quot;$$p_incluyeotrossaldos$$&quot; => 'S',
 	PLACEHOLDER.&quot;$$p_incluyeproductoapv$$&quot; => 'N'
  )
  WHERE &quot;TipoRegistro&quot; = 'MOV';


END /********* End Procedure Script ************/</definition>
