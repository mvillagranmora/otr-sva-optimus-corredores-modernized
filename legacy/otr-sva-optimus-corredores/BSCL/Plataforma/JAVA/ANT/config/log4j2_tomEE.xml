<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%tn] %X{dd.trace_id:-0} %X{dd.span_id:-0} %X %-5level %logger{36} - %msg%n"/> 
      
    </Console>
    
    <RollingFile name="RollingFile" fileName="${sys:user.home}/logs/optimus.log"
                 filePattern="${sys:user.home}/logs/optimus-%d{yyyy-MM-dd}.log">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%tn] %X{dd.trace_id:-0} %X{dd.span_id:-0} %X %-5level %logger{36} - %msg%n"/> 
      <Policies>
        <TimeBasedTriggeringPolicy />
      </Policies>
    </RollingFile>
    
  </Appenders>
  <Loggers>
    <Root level="debug">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="RollingFile"/>
    </Root>
  </Loggers>
</Configuration>