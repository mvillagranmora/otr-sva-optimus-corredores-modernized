LEFT OUTER JOIN &quot;BSCL.Plataforma.BD::INS.Bolsa&quot; As Bolsa ON Bolsa.&quot;IdBolsa&quot; = comprobante.&quot;IdBolsa&quot; &#xD;
LEFT OUTER JOIN &quot;BSCL&quot;.&quot;BSCL.Plataforma.BD::INS.TipoInstrumento&quot; As TipIns On TipIns.&quot;IdTipoInstrumento&quot; = comprobante.&quot;IdTipoInstrumento&quot; &#xD;
LEFT OUTER JOIN &quot;BSCL&quot;.&quot;BSCL.Plataforma.BD::PLA.Concepto&quot; AS Concepto ON Concepto.&quot;IdConcepto&quot; = comprobante.&quot;IdConcepto&quot; &#xD;
