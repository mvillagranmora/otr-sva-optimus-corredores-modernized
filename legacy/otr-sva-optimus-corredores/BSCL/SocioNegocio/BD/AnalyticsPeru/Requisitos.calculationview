  <calculationViews>
    <calculationView xsi:type="Calculation:SqlScriptView" id="Script_View">
      <descriptions/>
      <viewAttributes>
        <viewAttribute datatype="BIGINT" id="IdPersona"/>
        <viewAttribute datatype="NVARCHAR" id="GrupoRequisitos" length="40"/>
        <viewAttribute datatype="NVARCHAR" id="DescripcionRequisito" length="255"/>
        <viewAttribute datatype="NVARCHAR" id="Valor" length="255"/>
        <viewAttribute datatype="NVARCHAR" id="FechaCreacion" length="19"/>
        <viewAttribute datatype="NVARCHAR" id="FechaModificacion" length="19"/>
      </viewAttributes>
      <calculatedViewAttributes/>
      <definition> 
 /********* Begin Procedure Script ************/ 
 BEGIN 
 	  	 var_out = SELECT 
						SOC."IdPersona",
						TI."GrupoIndicador" AS "GrupoRequisitos",
						TI."NombreTipoIndicador" AS "DescripcionRequisito",
						I."ValorIndicador" AS "Valor",
						TO_NVARCHAR(I."FechaCreacion") AS "FechaCreacion",
						TO_NVARCHAR(I."FechaModificacion") AS "FechaModificacion"
					FROM "BSCL.Plataforma.BD::IND.Indicador" I
					INNER JOIN "BSCL.Plataforma.BD::IND.TipoIndicador" TI ON TI."IdTipoIndicador" = I."IdTipoIndicador"
					INNER JOIN "BSCL.SocioNegocio.BD::SOC.SocioDeNegocio" SOC ON SOC."IdCliente" = I."IdEntidad"
					WHERE "IdUso" = 'REQ';

END /********* End Procedure Script ************/</definition>
    </calculationView>
  </calculationViews>
