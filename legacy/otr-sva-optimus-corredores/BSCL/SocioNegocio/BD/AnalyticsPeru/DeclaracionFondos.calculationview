      </viewAttributes>
      <calculatedViewAttributes/>
      <definition> 
 /********* Begin Procedure Script ************/ 
 BEGIN 
 	  	 var_out = SELECT 
						SOC.&quot;IdPersona&quot;,
						TIPOP.&quot;Nombre&quot; AS &quot;TipoOperacion&quot;,
						TO_NVARCHAR(DOF.&quot;FechaDeclaracion&quot;) AS &quot;FechaDeclaracion&quot;,
						TOOF.&quot;IdTipoOperacionOrigenFondos&quot; AS &quot;TipoOrigen&quot;,
						DDOF.&quot;Valor&quot;,
						DOF.&quot;Comentario&quot;,
						ESTDOF.&quot;Nombre&quot; AS &quot;Estado&quot;
					FROM &quot;BSCL&quot;.&quot;BSCL.SocioNegocio.BD::CLI.DeclaracionOrigenFondos&quot; DOF
					INNER JOIN &quot;BSCL&quot;.&quot;BSCL.SocioNegocio.BD::CLI.DetalleDeclaracionOrigenFondos&quot; DDOF ON DDOF.&quot;IdDeclaracionOrigenFondos&quot; = DOF.&quot;IdDeclaracionOrigenFondos&quot;
					LEFT JOIN &quot;BSCL.SocioNegocio.BD::CLI.TipoOrigenFondo&quot; as TIPOP ON TIPOP.&quot;IdTipoOrigenFondo&quot; = DDOF.&quot;IdTipoOrigenFondo&quot;
					LEFT JOIN &quot;BSCL.SocioNegocio.BD::CLI.TipoOperacionOrigenFondos&quot; TOOF ON TOOF.&quot;IdTipoOperacionOrigenFondos&quot; = DOF.&quot;IdTipoOperacionOrigenFondos&quot;
					LEFT JOIN &quot;BSCL&quot;.&quot;BSCL.SocioNegocio.BD::SOC.SocioDeNegocio&quot; SOC ON SOC.&quot;IdCliente&quot; = DOF.&quot;IdCliente&quot;
					LEFT JOIN &quot;BSCL.Plataforma.BD::PLA.Estado&quot; ESTDOF ON ESTDOF.&quot;IdEstado&quot; = DOF.&quot;IdEstado&quot;;


END /********* End Procedure Script ************/</definition>
