      <viewAttributes>
        <viewAttribute datatype="BIGINT" id="IdPersona"/>
        <viewAttribute datatype="NVARCHAR" id="TipoOperacion" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="FechaDeclaracion" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="TipoOrigen" length="100"/>
