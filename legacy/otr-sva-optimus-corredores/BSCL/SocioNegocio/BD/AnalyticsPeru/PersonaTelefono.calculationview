    <calculationView xsi:type="Calculation:SqlScriptView" id="Script_View">
      <descriptions/>
      <viewAttributes>
        <viewAttribute datatype="BIGINT" id="IdPersona"/>
        <viewAttribute datatype="BIGINT" id="IdTelefono"/>
        <viewAttribute datatype="BIGINT" id="IdPais"/>
        <viewAttribute datatype="NVARCHAR" id="Pais" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="Numero" length="40"/>
        <viewAttribute datatype="NVARCHAR" id="Anexo" length="40"/>
        <viewAttribute datatype="NVARCHAR" id="CodigoProposito" length="40"/>
        <viewAttribute datatype="NVARCHAR" id="Comentario" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="IdEstado" length="3"/>
        <viewAttribute datatype="NVARCHAR" id="NombreTipoTelefono" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="IdTipoTelefono" length="40"/>
        <viewAttribute datatype="NVARCHAR" id="DescripcionProposito" length="500"/>
        <viewAttribute datatype="NVARCHAR" id="FechaCreacion" length="20"/>
        
      </viewAttributes>
      <calculatedViewAttributes/>
      <definition> 
 /********* Begin Procedure Script ************/ 
 BEGIN 
     var_out =  
        SELECT 
            T."IdPersona",
            T."IdTelefono",
            T."IdPais",
            P."NombrePais" AS "Pais",
            T."Numero",
            T."Anexo",
            T."CodigoProposito",
            T."Comentario",
            T."IdEstado",
            TT."Nombre" AS "NombreTipoTelefono",
            T."IdTipoTelefono",
            PMC."Descripcion" AS "DescripcionProposito",
            T."FechaCreacion"
        FROM "BSCL.SocioNegocio.BD::PER.Telefono" T
        LEFT JOIN "BSCL.Plataforma.BD::REG.Pais" P ON P."IdPais" = T."IdPais"
        LEFT JOIN "BSCL.SocioNegocio.BD::PER.PropositoMedioContacto" PMC ON PMC."IdPropositoMedioContacto" = T."CodigoProposito"
        LEFT JOIN "BSCL.SocioNegocio.BD::PER.TipoTelefono" TT ON TT."IdTipoTelefono" = T."IdTipoTelefono";

END /********* End Procedure Script ************/</definition>
    </calculationView>
