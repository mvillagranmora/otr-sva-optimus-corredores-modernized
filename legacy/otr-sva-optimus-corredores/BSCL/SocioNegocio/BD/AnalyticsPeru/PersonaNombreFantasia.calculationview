        <keyMapping columnObjectName="Script_View" columnName="DescripcionNombreFantasia"/>
      </attribute>
      <attribute id="IdPersona" order="3">
        <descriptions defaultDescription="IdPersona"/>
        <keyMapping columnObjectName="Script_View" columnName="IdPersona"/>
      </attribute>
      <attribute id="FechaCreacion" order="4">
        <descriptions defaultDescription="FechaCreacion"/>
        <keyMapping columnObjectName="Script_View" columnName="FechaCreacion"/>
      </attribute>
      <attribute id="IdEstado" order="5">
        <descriptions defaultDescription="IdEstado"/>
        <keyMapping columnObjectName="Script_View" columnName="IdEstado"/>
      </attribute>
    </attributes>
