    <calculationView xsi:type="Calculation:SqlScriptView" id="Script_View">
      <descriptions/>
      <viewAttributes>
        <viewAttribute datatype="BIGINT" id="IdPersona"/>
        <viewAttribute datatype="BIGINT" id="IdDireccionElectronicaPrincipal"/>
        <viewAttribute datatype="NVARCHAR" id="Direccion" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="CodigoProposito" length="40"/>
        <viewAttribute datatype="NVARCHAR" id="DescripcionProposito" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="Comentario" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="IdEstado" length="3"/>
        <viewAttribute datatype="NVARCHAR" id="IdUsuarioCreador" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="CodigoUsuario" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="FechaCreacion" length="20"/>
        
      </viewAttributes>
      <calculatedViewAttributes/>
      <definition> 
 /********* Begin Procedure Script ************/ 
 BEGIN 
     var_out =  
        SELECT 
            DF."IdPersona",
            DF."IdDireccionElectronica" AS "IdDireccionElectronicaPrincipal",
            DF."Direccion",
            DF."CodigoProposito",
            PMC."Descripcion" AS"DescripcionProposito",
            DF."Comentario",
            DF."IdEstado",
            DF."IdUsuarioCreador",
            U."CodigoUsuario",
            DF."FechaCreacion"
        FROM "BSCL.SocioNegocio.BD::PER.DireccionElectronica" DF
        LEFT JOIN "BSCL.SocioNegocio.BD::PER.PropositoMedioContacto" PMC ON PMC."IdPropositoMedioContacto" = DF."CodigoProposito"
        LEFT JOIN "BSCL.Plataforma.BD::ACC.Usuario" U ON U."IdUsuario" = DF."IdUsuarioCreador";

END /********* End Procedure Script ************/</definition>
    </calculationView>
