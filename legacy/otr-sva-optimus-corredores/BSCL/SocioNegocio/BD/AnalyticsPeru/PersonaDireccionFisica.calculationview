 /********* Begin Procedure Script ************/ 
 BEGIN 
     var_out =  
        SELECT 
    DF.&quot;IdPersona&quot;,
    DF.&quot;IdDireccionFisica&quot; AS &quot;IdDireccionFisicaPrincipal&quot;,
    DF.&quot;IdCiudad&quot;,
    CDP.&quot;NombreDivisionPais&quot; AS &quot;Ciudad&quot;,
    DF.&quot;Calle&quot;,
    DF.&quot;Numero&quot;,
    DF.&quot;Departamento&quot;,
    DF.&quot;CodigoProposito&quot;,
    DF.&quot;Comentario&quot;,
    DF.&quot;IdEstado&quot;,
    PMC.&quot;Descripcion&quot; AS&quot;DescripcionProposito&quot;,
    DF.&quot;FechaCreacion&quot;,
    CDP.&quot;NombreClasificacionDivisionPais1&quot; AS &quot;Distrito&quot;,
    CDP.&quot;NombreClasificacionDivisionPais2&quot; AS &quot;Provincia&quot;
FROM &quot;BSCL.SocioNegocio.BD::PER.DireccionFisica&quot; DF
LEFT JOIN &quot;BSCL.SocioNegocio.BD::PER.PropositoMedioContacto&quot; PMC ON PMC.&quot;IdPropositoMedioContacto&quot; = DF.&quot;CodigoProposito&quot;   
LEFT JOIN &quot;BSCL.Plataforma.BD.Vistas::REG.ConsultarDivisionPais&quot; CDP ON DF.&quot;IdDivisionPais&quot; = CDP.&quot;IdDivisionPais&quot; AND DF.&quot;IdCiudad&quot; = CDp.&quot;IdCiudad&quot;;

END /********* End Procedure Script ************/</definition>
