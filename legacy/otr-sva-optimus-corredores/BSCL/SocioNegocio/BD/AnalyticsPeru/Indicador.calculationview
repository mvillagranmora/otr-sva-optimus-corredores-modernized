 /********* Begin Procedure Script ************/ 
 BEGIN 
 	  	 var_out = SELECT 
						I.&quot;IdIndicador&quot;,
						I.&quot;IdEntidad&quot;,
						I.&quot;IdTipoEntidad&quot;,
						I.&quot;IdTipoIndicador&quot;,
						I.&quot;ModeloCliente&quot;,
						I.&quot;IdEmpresa&quot;,
						I.&quot;ValorIndicador&quot;,
						TO_NVARCHAR(I.&quot;FechaIngreso&quot;) AS &quot;FechaIngreso&quot;,
						TO_NVARCHAR(I.&quot;FechaCreacion&quot;) AS &quot;FechaCreacion&quot;,
						TO_NVARCHAR(I.&quot;FechaModificacion&quot;) AS &quot;FechaModificacion&quot;,
						TI.&quot;NombreTipoIndicador&quot;,
						TI.&quot;ClaseDato&quot;,
						TI.&quot;IdUso&quot;,
						TI.&quot;GrupoIndicador&quot;,
						TI.&quot;ValorIndicadorDefecto&quot;,
						TI.&quot;CodigoTipoIndicador&quot;,
						DI.&quot;DetalleIndicador&quot;,
						DI.&quot;Codigo&quot;
					FROM BSCL.&quot;BSCL.Plataforma.BD::IND.Indicador&quot; I
					INNER JOIN BSCL.&quot;BSCL.Plataforma.BD::IND.TipoIndicador&quot; TI ON TI.&quot;IdTipoIndicador&quot; = I.&quot;IdTipoIndicador&quot;
					INNER JOIN BSCL.&quot;BSCL.Plataforma.BD::IND.DetalleIndicador&quot; DI ON DI.&quot;IdTipoIndicador&quot; = I.&quot;IdTipoIndicador&quot;;

END /********* End Procedure Script ************/</definition>
