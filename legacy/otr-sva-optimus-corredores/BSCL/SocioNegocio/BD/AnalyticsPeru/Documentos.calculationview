    <calculationView xsi:type="Calculation:SqlScriptView" id="Script_View">
      <descriptions/>
      <viewAttributes>
        <viewAttribute datatype="BIGINT" id="IdPersona"/>
        <viewAttribute datatype="NVARCHAR" id="Grupo_Documentos" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="NombreDocumento" length="100"/>
        <viewAttribute datatype="BIGINT" id="IdCliente"/>
        <viewAttribute datatype="NVARCHAR" id="Estado" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="FechaVencimiento" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="FechaCreacion" length="100"/>
        <viewAttribute datatype="NVARCHAR" id="FechaModificacion" length="100"/>
      </viewAttributes>
      <calculatedViewAttributes/>
      <definition> 
 /********* Begin Procedure Script ************/ 
 BEGIN 
 	  	 var_out = SELECT
					SOC.&quot;IdPersona&quot;
					,TPO.&quot;IdTipoDocumento&quot; AS &quot;Grupo_Documentos&quot; 
					,TPO.&quot;NombreDocumento&quot;
					,DOC.&quot;IdCliente&quot;
					,EST.&quot;Nombre&quot; AS &quot;Estado&quot;
					,TO_NVARCHAR(ANX.&quot;FechaVigencia&quot;) AS &quot;FechaVencimiento&quot;
					,TO_NVARCHAR(ANX.&quot;FechaIngreso&quot;) AS &quot;FechaCreacion&quot;
					,TO_NVARCHAR(ANX.&quot;FechaModificacion&quot;) AS &quot;FechaModificacion&quot;
				from &quot;BSCL&quot;.&quot;BSCL.Plataforma.BD::DOC.TipoDocumento&quot; TPO 
				INNER JOIN &quot;BSCL&quot;.&quot;BSCL.Plataforma.BD::DOC.Documento&quot; DOC ON TPO.&quot;IdTipoDocumento&quot; = DOC.&quot;IdTipoDocumento&quot;
				LEFT JOIN &quot;BSCL&quot;.&quot;BSCL.Plataforma.BD::DOC.Anexo&quot; ANX ON ANX.&quot;IdDocumento&quot; = DOC.&quot;IdDocumento&quot; 
					AND ANX.&quot;IdAnexo&quot; = DOC.&quot;IdUltimoAnexo&quot; AND ANX.&quot;IdEstado&quot; != 'VCD'
				INNER JOIN &quot;BSCL.SocioNegocio.BD.Vistas::SOC.UIBlotterConsultarSocioDeNegocio&quot; SOC ON DOC.&quot;IdCliente&quot; = SOC.&quot;IdCliente&quot;
				JOIN &quot;BSCL.Plataforma.BD::PLA.Estado&quot; EST ON EST.&quot;IdEstado&quot; = IFNULL(ANX.&quot;IdEstado&quot;,'PEN')
				WHERE IFNULL(SOC.&quot;IdCliente&quot;,0) &lt;> 0;

END /********* End Procedure Script ************/</definition>
    </calculationView>
  </calculationViews>
