 /********* Begin Procedure Script ************/ 
 BEGIN 
     var_out = SELECT
                    F.&quot;IdPersona&quot;
                    ,F.&quot;NombreClasificacionFatca&quot; AS &quot;Clasificacion_Fatca&quot;
                    ,TO_NVARCHAR(F.&quot;FechaFirmaFormulario&quot;) AS &quot;FechaFirmaFormularioFatca&quot;
                    ,F.&quot;AutorizacionInformarOrganismo&quot; AS &quot;AutorizacionInformarOrganismoFatca&quot;
                    ,F.&quot;ParticipacionSociedadesUSA&quot; AS &quot;ParticipacionMayor&quot;
                    ,F.&quot;OrdenPermanente&quot; AS &quot;OrdenesPermanentesParaTransferirFondos&quot;
                    ,F.&quot;IdPaisNacionalidad1&quot; AS &quot;Nacionalidad1&quot;
                    ,CASE WHEN F.&quot;IdPaisNacionalidad1&quot; = 0 THEN NULL ELSE P1.&quot;NombrePais&quot; END  as &quot;NombreNacionalidad1&quot;
                    ,F.&quot;IdPaisNacionalidad2&quot; AS &quot;Nacionalidad2&quot;
                    ,CASE WHEN F.&quot;IdPaisNacionalidad2&quot; = 0 THEN NULL ELSE P2.&quot;NombrePais&quot; END  as &quot;NombreNacionalidad2&quot;
                    ,F.&quot;IdPaisNacionalidad3&quot; AS &quot;Nacionalidad3&quot;
                    ,CASE WHEN F.&quot;IdPaisNacionalidad3&quot; = 0 THEN NULL ELSE P3.&quot;NombrePais&quot; END  as &quot;NombreNacionalidad3&quot;
                    ,F.&quot;IdPaisNacionalidad4&quot; AS &quot;Nacionalidad4&quot;
                    ,CASE WHEN F.&quot;IdPaisNacionalidad4&quot; = 0 THEN NULL ELSE P4.&quot;NombrePais&quot; END  as &quot;NombreNacionalidad4&quot;
                    ,F.&quot;IdPaisResidencia&quot; AS &quot;PaisResidencia&quot;
                    ,CASE WHEN F.&quot;IdPaisResidencia&quot; = 0 THEN NULL ELSE P5.&quot;NombrePais&quot; END  as &quot;NombrePaisResidencia&quot;
                    ,F.&quot;ExcepcionResidente&quot; AS &quot;ResidenteUSA&quot;
                    ,F.&quot;ExcepcionNacimiento&quot; AS &quot;LugarDeNacimientoEnUSA&quot;
                    ,F.&quot;ExcepcionDomicilio&quot; AS &quot;DomicilioOCodigoPostalEnUSA&quot;
                    ,F.&quot;ExcepcionTelefono&quot; AS &quot;NumeroTelefonoEnUSA&quot;
                    ,F.&quot;ExcepcionOrdenPermanente&quot; AS &quot;OrdenesPermanentesParaTransferirFondosEnUSA&quot;
                    ,F.&quot;ExcepcionFirma&quot; AS &quot;FirmaAutorizadaQueSeConcedeAUnaPersonaConIndicios&quot;
                    ,F.&quot;FechaCreacion&quot;
                    ,F.&quot;FechaModificacion&quot;
                FROM &quot;BSCL.SocioNegocio.BD.Vistas::PER.ConsultarPersonaFatca&quot; F
                LEFT JOIN &quot;BSCL.Plataforma.BD::REG.Pais&quot; P1 ON P1.&quot;IdPais&quot; = F.&quot;IdPaisNacionalidad1&quot;
                LEFT JOIN &quot;BSCL.Plataforma.BD::REG.Pais&quot; P2 ON P2.&quot;IdPais&quot; = F.&quot;IdPaisNacionalidad2&quot;
                LEFT JOIN &quot;BSCL.Plataforma.BD::REG.Pais&quot; P3 ON P3.&quot;IdPais&quot; = F.&quot;IdPaisNacionalidad3&quot;
                LEFT JOIN &quot;BSCL.Plataforma.BD::REG.Pais&quot; P4 ON P4.&quot;IdPais&quot; = F.&quot;IdPaisNacionalidad4&quot;
                LEFT JOIN &quot;BSCL.Plataforma.BD::REG.Pais&quot; P5 ON P5.&quot;IdPais&quot; = F.&quot;IdPaisResidencia&quot;;
                
                
END /********* End Procedure Script ************/</definition>
