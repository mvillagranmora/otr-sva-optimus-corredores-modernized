  <dataSources/>
  <calculationViews>
    <calculationView xsi:type="Calculation:SqlScriptView" id="Script_View">
      <viewAttributes>
        <viewAttribute datatype="BIGINT" id="IdUsuario"/>
        <viewAttribute datatype="BIGINT" id="IdRegistro"/>
        <viewAttribute datatype="DATE" id="FechaCambioPerfil"/>
      </viewAttributes>
      <calculatedViewAttributes/>
      <definition> 
 /********* Begin Procedure Script ************/ 
 BEGIN 
 	 var_out = select L.&quot;IdUsuario&quot;, L.&quot;IdRegistro&quot;, MAX(L.&quot;FechaLog&quot;) as &quot;FechaCambioPerfil&quot;
            from &quot;BSCL&quot;.&quot;BSCL.Plataforma.BD::PLA.Log&quot; as L
            JOIN &quot;BSCL&quot;.&quot;BSCL.Plataforma.BD::PLA.DetalleLog&quot; as DL ON L.&quot;IdLog&quot; = DL.&quot;IdLog&quot;
            where L.&quot;IdTipoRegistro&quot; = 'PORTAFOLIO' AND UPPER(DL.&quot;CampoRegistro&quot;) = 'IDPERFILCOMERCIALBASEORIGEN'
             group by L.&quot;IdUsuario&quot;, L.&quot;IdRegistro&quot;  ;

END /********* End Procedure Script ************/</definition>
    </calculationView>
  </calculationViews>
