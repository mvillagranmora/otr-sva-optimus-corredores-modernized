      <definition>&#xD;
 /********* Begin Procedure Script ************/ &#xD;
 BEGIN &#xD;
     var_out = SELECT&#xD;
                    A.&quot;IdAsignacion&quot;,&#xD;
                    CASE WHEN A.&quot;IdOrden&quot; = 0 THEN NULL ELSE A.&quot;IdOrden&quot; END AS &quot;IdOrden&quot;,&#xD;
                    CASE WHEN A.&quot;IdTransaccion&quot; = 0 THEN NULL ELSE A.&quot;IdTransaccion&quot; END AS &quot;IdTransaccion&quot;,                &#xD;
                    CASE WHEN T.&quot;IdTransaccionOd&quot; = 0 THEN NULL ELSE T.&quot;IdTransaccionOd&quot; END AS &quot;IdTransaccionOd&quot;,&#xD;
                    CAST(T.&quot;Folio&quot; AS NVARCHAR(40)) AS &quot;Folio&quot;,&#xD;
                    T.&quot;FolioCartera&quot;,&#xD;
                    CASE WHEN O.&quot;IdLibroOrdenes&quot; = 0 THEN NULL ELSE O.&quot;IdLibroOrdenes&quot; END AS &quot;IdLibroOrdenes&quot;,&#xD;
                    0 AS &quot;IdLibroOrdenes_1&quot;,&#xD;
                    TO_NVARCHAR(CASE WHEN IFNULL(A.&quot;FechaAsignacion&quot;,'')= '' THEN '0001-01-01 00:00:00' &#xD;
                        ELSE  &#xD;
                           CASE WHEN  A.&quot;FechaAsignacion&quot; IN ('0001-01-01 00:00:00','1900-01-01 00:00:00.0') THEN '0001-01-01 00:00:00' &#xD;
                           ELSE LEFT(TO_CHAR(ADD_SECONDS (A.&quot;FechaAsignacion&quot;, CONFIGURACION.&quot;Valor&quot;)),19)&#xD;
                        END &#xD;
                    END) AS &quot;FechaAsignacion&quot;,&#xD;
                    TO_NVARCHAR(CASE WHEN IFNULL(A.&quot;FechaIngresoRegistro&quot;,'')= '' THEN '0001-01-01 00:00:00' &#xD;
                        ELSE  &#xD;
                           CASE WHEN  A.&quot;FechaIngresoRegistro&quot; IN ('0001-01-01 00:00:00','1900-01-01 00:00:00.0') THEN '0001-01-01 00:00:00' &#xD;
                           ELSE LEFT(TO_CHAR(ADD_SECONDS (A.&quot;FechaIngresoRegistro&quot;, CONFIGURACION.&quot;Valor&quot;)),19)&#xD;
                        END &#xD;
                    END) AS &quot;FechaIngresoRegistro&quot;,&#xD;
                    T.&quot;FechaLiquidacion&quot;,&#xD;
                    O.&quot;FechaOperacion&quot; AS &quot;FechaOperacionOrden&quot;,&#xD;
                    TO_NVARCHAR(CASE WHEN IFNULL(O.&quot;FechaOperacion&quot;,'')= '' THEN '0001-01-01 00:00:00' &#xD;
                        ELSE  &#xD;
                           CASE WHEN  O.&quot;FechaOperacion&quot; IN ('0001-01-01 00:00:00','1900-01-01 00:00:00.0') THEN '0001-01-01 00:00:00' &#xD;
                           ELSE LEFT(TO_CHAR(ADD_SECONDS (O.&quot;FechaOperacion&quot;, CONFIGURACION.&quot;Valor&quot;)),19)&#xD;
                        END &#xD;
                    END) AS &quot;FechaOperacionTransaccion&quot;,&#xD;
                    CASE WHEN T.&quot;IdTipoOperacion&quot; = '' THEN NULL ELSE T.&quot;IdTipoOperacion&quot; END AS &quot;IdTipoOperacion&quot;,&#xD;
                    CASE WHEN T.&quot;IdBolsa&quot; = '' THEN NULL ELSE T.&quot;IdBolsa&quot; END AS &quot;IdBolsa&quot;,&#xD;
                    CASE WHEN T.&quot;IdBolsa&quot; = '' THEN NULL ELSE T.&quot;IdBolsa&quot; END AS &quot;IdBolsaDistribucion&quot;,--?????&#xD;
                    T.&quot;IdCorredorContraparte&quot; AS &quot;IdCorredor&quot;,&#xD;
                    CASE WHEN T.&quot;IdEmisor&quot; = '' THEN NULL ELSE CAST(T.&quot;IdEmisor&quot; AS NVARCHAR(40)) END AS &quot;IdEmisor&quot;,&#xD;
                    T.&quot;IdEmpresa&quot;,&#xD;
                    CASE WHEN T.&quot;CodigoOperadorContraparte&quot; = '' THEN NULL ELSE CAST(T.&quot;CodigoOperadorContraparte&quot; AS NVARCHAR(40)) END AS &quot;IdOperadorContraparte&quot;,&#xD;
                    CASE WHEN T.&quot;CodigoOperadorCorredor&quot; = '' THEN NULL ELSE CAST(T.&quot;CodigoOperadorCorredor&quot; AS NVARCHAR(40)) END AS &quot;IdOperadorCorredor&quot;,&#xD;
                    CASE WHEN O.&quot;IdTipoCanalDistribucion&quot; = '' THEN NULL ELSE O.&quot;IdTipoCanalDistribucion&quot; END AS &quot;IdTipoCanalDistribucion&quot;,&#xD;
                    CASE WHEN O.&quot;IdTipoCanalIngreso&quot; = '' THEN NULL ELSE O.&quot;IdTipoCanalIngreso&quot; END AS &quot;IdTipoCanalIngreso&quot;,&#xD;
                    CASE WHEN O.&quot;IdTipoPrecio&quot; = '' THEN NULL ELSE O.&quot;IdTipoPrecio&quot; END AS &quot;IdTipoPrecioOrden&quot;,&#xD;
                    O.&quot;IdTipoVigenciaOrden&quot;,&#xD;
                    CASE WHEN A.&quot;IdMovimientoComprobante&quot; = 0 THEN NULL ELSE A.&quot;IdMovimientoComprobante&quot; END AS &quot;IdMovimientoComprobante&quot;,&#xD;
                    CASE WHEN O.&quot;IdProducto&quot; = '' THEN NULL ELSE O.&quot;IdProducto&quot; END AS &quot;IdProducto&quot;,&#xD;
                    CAST(TP.&quot;Nombre&quot; AS NVARCHAR(100)) AS &quot;NombreProducto&quot;,&#xD;
                    CASE WHEN T.&quot;IdInstrumento&quot; = 0 THEN NULL ELSE T.&quot;IdInstrumento&quot; END AS &quot;IdInstrumento&quot;,&#xD;
                    CASE WHEN T.&quot;IdInstrumentoSubyacente&quot; = 0 THEN NULL ELSE T.&quot;IdInstrumentoSubyacente&quot; END AS &quot;IdInstrumentoSubyacente&quot;,&#xD;
                    CASE WHEN T.&quot;IdClasificacionTipoInstrumento&quot; = '' THEN NULL ELSE T.&quot;IdClasificacionTipoInstrumento&quot; END AS &quot;IdClasificacionTipoInstrumento&quot;,&#xD;
                    CASE WHEN T.&quot;IdTipoInstrumento&quot; = '' THEN NULL ELSE T.&quot;IdTipoInstrumento&quot; END AS &quot;IdTipoInstrumento&quot;,&#xD;
                    CAST(TI.&quot;Nombre&quot; AS NVARCHAR(100)) AS &quot;NombreTipoInstrumento&quot;,&#xD;
                    CASE WHEN T.&quot;IdClasificacionTipoInstrumento&quot; ='IF' THEN CAST(T.&quot;NemotecnicoSVS&quot; AS NVARCHAR(40)) ELSE CAST(T.&quot;Nemotecnico&quot; AS NVARCHAR(40)) END AS &quot;Nemotecnico&quot;,&#xD;
                    CAST(I.&quot;Nemotecnico&quot; AS NVARCHAR(40)) AS &quot;NemotecnicoSubyacente&quot;,&#xD;
                    CASE WHEN T.&quot;IdMoneda&quot; = '' THEN NULL ELSE T.&quot;IdMoneda&quot; END AS &quot;IdMoneda&quot;,&#xD;
                    CASE WHEN O.&quot;IdMonedaLiquidacionOrden&quot; = '' THEN NULL ELSE O.&quot;IdMonedaLiquidacionOrden&quot; END AS &quot;IdMonedaLiquidacion&quot;,&#xD;
                    CASE WHEN I.&quot;IdMoneda&quot; = '' THEN NULL ELSE I.&quot;IdMoneda&quot; END AS &quot;IdMonedaSubyacente&quot;,&#xD;
                    COALESCE(CCAP.&quot;Impuesto&quot;, 0.0) AS &quot;Impuesto&quot;,&#xD;
                    COALESCE(CCAP.&quot;ComisBVL&quot;, 0.0) AS &quot;ComisBVL&quot;,&#xD;
                    COALESCE(CCAP.&quot;ComisCavali&quot;, 0.0) AS &quot;ComisCavali&quot;,&#xD;
                    COALESCE(CCAP.&quot;ComisGarantia&quot;, 0.0) AS &quot;ComisGarantia&quot;,&#xD;
                    COALESCE(CCAP.&quot;ComisSAB&quot;, 0.0) AS &quot;ComisSAB&quot;,&#xD;
                    COALESCE(CCAP.&quot;ComisSMV&quot;, 0.0) AS &quot;ComisSMV&quot;,&#xD;
                    COALESCE(CCAP.&quot;PorcentajeComisSAB&quot;, 0.0) AS &quot;PorcentajeComisSAB&quot;,&#xD;
                    A.&quot;CantidadAsignada&quot;,&#xD;
                    O.&quot;Cantidad&quot; AS &quot;CantidadOrden&quot;,&#xD;
                    T.&quot;Cantidad&quot; AS &quot;CantidadTransaccion&quot;,&#xD;
                    O.&quot;PrecioMercado&quot;,&#xD;
                    O.&quot;PrecioOrden&quot;,&#xD;
                    T.&quot;Precio&quot; AS &quot;PrecioTransaccion&quot;,&#xD;
                    A.&quot;MontoAsignado&quot;,&#xD;
                    A.&quot;MontoAsignadoLiquidacion&quot;,&#xD;
                    A.&quot;MontoAsignadoLocal&quot;,&#xD;
                    T.&quot;Monto&quot; AS &quot;MontoTransaccion&quot;,&#xD;
                    T.&quot;Plazo&quot;,&#xD;
                    CASE T.&quot;EsVentaCorta&quot; WHEN 'S' THEN O.&quot;TasaVentaCorta&quot; ELSE T.&quot;Tasa&quot; END AS &quot;TasaOrden&quot;,&#xD;
                    T.&quot;Tasa&quot; AS &quot;TasaTransaccion&quot;,&#xD;
                    A.&quot;TipoCambio&quot;,&#xD;
                    '' AS &quot;OrdenEspecial&quot;,&#xD;
                    T.&quot;EsAPlazo&quot;,&#xD;
                    T.&quot;IndicadorOrdenDirecta&quot; AS &quot;EsOD&quot;,&#xD;
                    T.&quot;EsVentaCorta&quot;,&#xD;
                    CASE WHEN T.&quot;IdCondicionDeLiquidacion&quot; = '' THEN NULL ELSE T.&quot;IdCondicionDeLiquidacion&quot; END AS &quot;IdCondicionDeLiquidacion&quot;,&#xD;
                    CAST(O.&quot;Glosa&quot; AS NVARCHAR(520)) AS &quot;GlosaOrden&quot;,&#xD;
                    CASE WHEN A.&quot;IdEstadoAsignacion&quot; = '' THEN NULL ELSE A.&quot;IdEstadoAsignacion&quot; END AS &quot;IdEstadoAsignacion&quot;,&#xD;
                    CASE WHEN O.&quot;IdEstadoOrden&quot; = '' THEN NULL ELSE O.&quot;IdEstadoOrden&quot; END AS &quot;IdEstadoOrden&quot;,&#xD;
                    CASE WHEN T.&quot;IdEstado&quot; = '' THEN NULL ELSE T.&quot;IdEstado&quot; END AS &quot;IdEstadoTransaccion&quot;,&#xD;
                    CASE WHEN O.&quot;IdCliente&quot; = 0 THEN NULL ELSE O.&quot;IdCliente&quot; END AS &quot;IdCliente&quot;,&#xD;
                    CASE WHEN AC.&quot;IdPersona&quot; = 0 THEN NULL ELSE AC.&quot;IdPersona&quot; END AS &quot;IdPersona&quot;,&#xD;
                    CAST(AC.&quot;DocumentoIdentidad&quot; AS NVARCHAR(40)) AS &quot;IUP&quot;,&#xD;
                    CAST(DI.&quot;DocumentoIdentidadAsociado&quot; AS NVARCHAR(40)) AS &quot;NumeroDocumento&quot;,&#xD;
                    CAST(DI.&quot;IdTipoDocumentoIdentidadAsociado&quot; AS NVARCHAR(40)) AS &quot;TipoDeDocumento&quot;,&#xD;
                    CAST(AC.&quot;NombreCompleto&quot; AS NVARCHAR(100)) AS &quot;NombreCompletoCliente&quot;,&#xD;
                    &#xD;
                    CASE WHEN CE2.&quot;CodigoEmpleado&quot; = '' THEN NULL ELSE CE2.&quot;CodigoEmpleado&quot; END AS &quot;CodigoAsesorPortafolio&quot;, --------------------------&#xD;
                    CAST(CE2.&quot;NombreCompleto&quot; AS NVARCHAR(100)) AS &quot;AsesorPortafolio&quot;,&#xD;
                    CAST(P.&quot;CodigoPortafolio&quot; AS NVARCHAR(100)) AS &quot;CodigoPortafolio&quot;,&#xD;
                    CAST(P.&quot;DescripcionPortafolio&quot; AS NVARCHAR(100)) AS &quot;DescripcionPortafolio&quot;,&#xD;
                    CAST(PEA.&quot;NombreCompleto&quot; AS NVARCHAR(100)) AS &quot;AutorizadorDeOrden&quot;,&#xD;
                    CASE WHEN CE.&quot;CodigoEmpleado&quot; = '' THEN NULL ELSE CE.&quot;CodigoEmpleado&quot; END AS &quot;CodigoEmpleadoDigitador&quot;,&#xD;
                    CAST(CE2.&quot;IdSucursal&quot; AS NVARCHAR(100)) AS &quot;CodigoSucursal&quot;,&#xD;
                    CAST(CE2.&quot;NombreSucursal&quot; AS NVARCHAR(100)) AS &quot;Sucursal&quot;,&#xD;
                    CASE WHEN O.&quot;IdEmpleadoDigitador&quot; = 0 THEN NULL ELSE O.&quot;IdEmpleadoDigitador&quot; END AS &quot;IdEmpleadoDigitador&quot;,&#xD;
                    --NUEVOS&#xD;
                    MPAGO.&quot;Nombre&quot; AS &quot;NombreMedioDePago&quot;,&#xD;
                    TOPE.&quot;Nombre&quot; AS &quot;NombreTipoOperacion&quot;,&#xD;
                    TOPE.&quot;AccionOperacion&quot;,&#xD;
                    BOLSA.&quot;Nombre&quot; AS &quot;NombreBolsaDistribucion&quot;,&#xD;
                    BOLSA.&quot;Nombre&quot; AS &quot;NombreBolsa&quot;,    &#xD;
                    TCANING.&quot;Nombre&quot; AS &quot;NombreCanalIngreso&quot;,&#xD;
                    TISUB.&quot;Nombre&quot; AS &quot;NombreTipoInstrumentoSubyacente&quot;,&#xD;
                    TISUB.&quot;IdTipoInstrumento&quot; AS &quot;IdTipoInstrumentoSubyacente&quot;,&#xD;
                    CASE WHEN TISUB.&quot;IdClasificacionTipoInstrumento&quot; = '' THEN NULL ELSE TISUB.&quot;IdClasificacionTipoInstrumento&quot; END AS &quot;IdClasificacionTipoInstrumentoSubyacente&quot;,&#xD;
                    AC.&quot;DocumentoIdentidadAdicional&quot; AS &quot;RUT&quot;,&#xD;
                    TCB.&quot;NombreTipoCuentaBancaria&quot; AS &quot;TipoCuentaBancariaOrden&quot;,&#xD;
                    FDPO.&quot;NumeroCuentaBancaria&quot; AS &quot;CuentaBancariaOrden&quot;,&#xD;
                    BE.&quot;Codigo&quot; AS &quot;Broker&quot;,&#xD;
                    PEBRK.&quot;NombreCompleto&quot; AS &quot;NombreBroker&quot;&#xD;
                 FROM &quot;BSCL.Orden.BD::ORD.Asignacion&quot; A&#xD;
                INNER JOIN &quot;BSCL.Orden.BD::ORD.Transaccion&quot; T ON T.&quot;IdTransaccion&quot; = A.&quot;IdTransaccion&quot;&#xD;
                INNER JOIN &quot;BSCL.Orden.BD::ORD.Orden&quot; O ON O.&quot;IdOrden&quot; = A.&quot;IdOrden&quot;&#xD;
                INNER JOIN &quot;BSCL.Plataforma.BD::INS.Instrumento&quot; I ON I.&quot;IdInstrumento&quot; = T.&quot;IdInstrumento&quot;&#xD;
                INNER JOIN &quot;BSCL.SocioNegocio.BD.Vistas::CLI.ConsultarCliente&quot; AC ON AC.&quot;IdCliente&quot; = O.&quot;IdCliente&quot;&#xD;
                INNER JOIN &quot;BSCL.SocioNegocio.BD::PER.DocumentoIdentidad&quot; DI ON DI.&quot;IdPersona&quot; = AC.&quot;IdPersona&quot; AND DI.&quot;DocumentoIdentidad&quot; = AC.&quot;DocumentoIdentidad&quot;&#xD;
                INNER JOIN &quot;BSCL.Portafolio.BD.Vistas::ConsultarPortafolio&quot; P ON P.&quot;IdPortafolio&quot; = O.&quot;IdPortafolioCliente&quot;&#xD;
                INNER JOIN &quot;BSCL.Plataforma.BD::INS.TipoProducto&quot; TP ON TP.&quot;IdTipoProducto&quot; = O.&quot;IdProducto&quot;&#xD;
                INNER JOIN &quot;BSCL.Plataforma.BD::INS.TipoInstrumento&quot; TI ON TI.&quot;IdTipoInstrumento&quot; = O.&quot;IdTipoInstrumento&quot;&#xD;
                LEFT JOIN &quot;BSCL.Orden.BD.Vistas::ConsultarCobrosAsignacionPeru&quot; CCAP ON CCAP.&quot;IdAsignacion&quot; = A.&quot;IdAsignacion&quot;&#xD;
                LEFT JOIN &quot;BSCL.SocioNegocio.BD.Vistas::EMP.ConsultarEmpleado&quot; CE ON CE.&quot;IdEmpleado&quot; = O.&quot;IdEmpleadoDigitador&quot;&#xD;
                LEFT JOIN &quot;BSCL.SocioNegocio.BD.Vistas::EMP.ConsultarEmpleado&quot; CE2 ON CE2.&quot;IdEmpleado&quot; = O.&quot;IdEmpleadoPortafolio&quot;&#xD;
                LEFT JOIN &quot;BSCL.SocioNegocio.BD.Vistas::PER.ConsultarPersona&quot; PEA ON PEA.&quot;IdPersona&quot; = O.&quot;IdPersonaAutorizadoDarOrdenes&quot;&#xD;
                LEFT JOIN &quot;BSCL.Plataforma.BD::PLA.BrokerExtranjero&quot; BE ON BE.&quot;IdPersona&quot; = P.&quot;IdPersonaBrokerExtranjero&quot;&#xD;
                LEFT JOIN &quot;BSCL.SocioNegocio.BD.Vistas::PER.ConsultarPersona&quot; PEBRK ON PEBRK.&quot;IdPersona&quot; = P.&quot;IdPersonaBrokerExtranjero&quot;&#xD;
                &#xD;
                LEFT JOIN &quot;BSCL.Plataforma.BD::INS.Bolsa&quot; BOLSA ON BOLSA.&quot;IdBolsa&quot; = T.&quot;IdBolsa&quot;&#xD;
                LEFT JOIN &quot;BSCL.Plataforma.BD::PLA.TipoCanalIngreso&quot; TCANING ON TCANING.&quot;IdTipoCanalIngreso&quot; = O.&quot;IdTipoCanalIngreso&quot;&#xD;
                LEFT JOIN &quot;BSCL.Orden.BD::ORD.FormaDePagoOrden&quot; FDPO ON FDPO.&quot;IdOrden&quot; = O.&quot;IdOrden&quot; AND FDPO.&quot;IdMedioDePago&quot; IN ('TRA','TBC')&#xD;
                LEFT JOIN &quot;BSCL.Plataforma.BD::BAN.TipoCuentaBancaria&quot; TCB ON FDPO.&quot;IdTipoCuentaBancaria&quot; = TCB.&quot;IdTipoCuentaBancaria&quot;&#xD;
                LEFT JOIN &quot;BSCL.Plataforma.BD::INS.Instrumento&quot; ISUB ON ISUB.&quot;IdInstrumento&quot; = T.&quot;IdInstrumentoSubyacente&quot;&#xD;
                LEFT JOIN &quot;BSCL.Plataforma.BD::INS.TipoInstrumento&quot; TISUB ON TISUB.&quot;IdTipoInstrumento&quot; = ISUB.&quot;IdTipoInstrumento&quot;&#xD;
                LEFT JOIN &quot;BSCL.Plataforma.BD::PAG.MedioDePago&quot; MPAGO ON MPAGO.&quot;IdMedioDePago&quot; = FDPO.&quot;IdMedioDePago&quot;&#xD;
                LEFT JOIN &quot;BSCL.Plataforma.BD::INS.TipoOperacion&quot; TOPE ON TOPE.&quot;IdTipoOperacion&quot; = T.&quot;IdTipoOperacion&quot;&#xD;
