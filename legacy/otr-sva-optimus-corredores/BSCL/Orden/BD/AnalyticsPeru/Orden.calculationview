 /********* Begin Procedure Script ************/ &#xD;
 BEGIN  &#xD;
 
 
     var_out = 	SELECT&#xD;
                O.&quot;IdOrden&quot;,&#xD;
                CASE WHEN O.&quot;IdLibroOrdenes&quot; = 0 THEN NULL ELSE O.&quot;IdLibroOrdenes&quot; END AS &quot;IdLibroOrdenes&quot;,&#xD;
                CAST(O.&quot;Folio&quot; AS NVARCHAR(40)) AS &quot;Folio&quot;,&#xD;
                CASE WHEN O.&quot;CodigoClaseOrden&quot; = '' THEN NULL ELSE CAST(O.&quot;CodigoClaseOrden&quot; AS NVARCHAR(40)) END AS &quot;CodigoClaseOrden&quot;,&#xD;
                TO_NVARCHAR(CASE WHEN IFNULL(O.&quot;FechaIngresoRegistro&quot;,'')= '' THEN '0001-01-01 00:00:00' &#xD;
                    ELSE  &#xD;
                       CASE WHEN  O.&quot;FechaIngresoRegistro&quot; IN ('0001-01-01 00:00:00','1900-01-01 00:00:00.0') THEN '0001-01-01 00:00:00' &#xD;
                       ELSE LEFT(TO_CHAR(ADD_SECONDS (O.&quot;FechaIngresoRegistro&quot;, CONFIGURACION.&quot;Valor&quot;)),19)&#xD;
                    END &#xD;
                END) AS &quot;FechaIngresoRegistro&quot;,&#xD;
                CAST(O.&quot;FechaLiquidacion&quot; AS NVARCHAR(10)) AS &quot;FechaLiquidacion&quot;,&#xD;
                TO_NVARCHAR(CASE WHEN IFNULL(O.&quot;FechaRecepcion&quot;,'')= '' THEN '0001-01-01 00:00:00' &#xD;
                    ELSE  &#xD;
                       CASE WHEN  O.&quot;FechaRecepcion&quot; IN ('0001-01-01 00:00:00','1900-01-01 00:00:00.0') THEN '0001-01-01 00:00:00' &#xD;
                       ELSE LEFT(TO_CHAR(ADD_SECONDS (O.&quot;FechaRecepcion&quot;, CONFIGURACION.&quot;Valor&quot;)),19)&#xD;
                    END &#xD;
                END) AS &quot;FechaRecepcion&quot;,&#xD;
                TO_NVARCHAR(CASE WHEN IFNULL(O.&quot;FechaSolicitudAnulacion&quot;,'')= '' THEN '0001-01-01 00:00:00' &#xD;
                    ELSE  &#xD;
                       CASE WHEN  O.&quot;FechaSolicitudAnulacion&quot; IN ('0001-01-01 00:00:00','1900-01-01 00:00:00.0') THEN '0001-01-01 00:00:00' &#xD;
                       ELSE LEFT(TO_CHAR(ADD_SECONDS (O.&quot;FechaSolicitudAnulacion&quot;, CONFIGURACION.&quot;Valor&quot;)),19)&#xD;
                    END &#xD;
                END) AS &quot;FechaSolicitudAnulacion&quot;,&#xD;
                TO_NVARCHAR(CASE WHEN IFNULL(O.&quot;FechaAnulacion&quot;,'')= '' THEN '0001-01-01 00:00:00' &#xD;
                    ELSE  &#xD;
                       CASE WHEN  O.&quot;FechaAnulacion&quot; IN ('0001-01-01 00:00:00','1900-01-01 00:00:00.0') THEN '0001-01-01 00:00:00' &#xD;
                       ELSE LEFT(TO_CHAR(ADD_SECONDS (O.&quot;FechaAnulacion&quot;, CONFIGURACION.&quot;Valor&quot;)),19)&#xD;
                    END &#xD;
                END) AS &quot;FechaAnulacion&quot;,&#xD;
                TO_NVARCHAR(CASE WHEN IFNULL(O.&quot;FechaOperacion&quot;,'')= '' THEN '0001-01-01 00:00:00' &#xD;
                    ELSE  &#xD;
                       CASE WHEN  O.&quot;FechaOperacion&quot; IN ('0001-01-01 00:00:00','1900-01-01 00:00:00.0') THEN '0001-01-01 00:00:00' &#xD;
                       ELSE LEFT(TO_CHAR(ADD_SECONDS (O.&quot;FechaOperacion&quot;, CONFIGURACION.&quot;Valor&quot;)),19)&#xD;
                    END &#xD;
                END) AS &quot;FechaOperacion&quot;,&#xD;
                CAST(O.&quot;FechaVigencia&quot; AS NVARCHAR(10)) AS &quot;FechaVigencia&quot;,&#xD;
                CAST(O.&quot;FechaVencimiento&quot; AS NVARCHAR(10)) AS &quot;FechaVencimiento&quot;,&#xD;
                CAST(O.&quot;FechaEmision&quot; AS NVARCHAR(10)) AS &quot;FechaEmision&quot;,&#xD;
                CAST(O.&quot;FechaAceptacion&quot; AS NVARCHAR(10)) AS &quot;FechaAceptacion&quot;,&#xD;
                CAST(O.&quot;FechaAutorizacion&quot; AS NVARCHAR(10)) AS &quot;FechaAutorizacion&quot;,&#xD;
                TO_NVARCHAR(CASE WHEN IFNULL(O.&quot;FechaOferta&quot;,'')= '' THEN '0001-01-01 00:00:00' &#xD;
                    ELSE  &#xD;
                       CASE WHEN  O.&quot;FechaOferta&quot; IN ('0001-01-01 00:00:00','1900-01-01 00:00:00.0') THEN '0001-01-01 00:00:00' &#xD;
                       ELSE LEFT(TO_CHAR(ADD_SECONDS (O.&quot;FechaOferta&quot;, CONFIGURACION.&quot;Valor&quot;)),19)&#xD;
                    END &#xD;
                END) AS &quot;FechaOferta&quot;,&#xD;
                CASE WHEN O.&quot;IdTipoOperacion&quot; = '' THEN NULL ELSE O.&quot;IdTipoOperacion&quot; END AS &quot;IdTipoOperacion&quot;,&#xD;
                CASE WHEN TipoOperacion.&quot;Nombre&quot; = '' THEN NULL ELSE TipoOperacion.&quot;Nombre&quot; END AS &quot;NombreTipoOperacion&quot;,&#xD;
				CASE WHEN TipoOperacion.&quot;AccionOrden&quot; = '' THEN NULL ELSE TipoOperacion.&quot;AccionOrden&quot; END AS &quot;AccionOrden&quot;,&#xD;
                CASE WHEN O.&quot;IdEmisor&quot; = '' THEN NULL ELSE CAST(O.&quot;IdEmisor&quot; AS NVARCHAR(40)) END AS &quot;IdEmisor&quot;,&#xD;
                O.&quot;IdEmpresa&quot;,&#xD;
                CASE WHEN O.&quot;IdBolsa&quot; = '' THEN NULL ELSE O.&quot;IdBolsa&quot; END AS &quot;IdBolsa&quot;,&#xD;
                CASE WHEN O.&quot;IdBolsaDistribucion&quot; = '' THEN NULL ELSE O.&quot;IdBolsaDistribucion&quot; END AS &quot;IdBolsaDistribucion&quot;,&#xD;
                CASE WHEN O.&quot;IdTipoCanalDistribucion&quot; = '' THEN NULL ELSE O.&quot;IdTipoCanalDistribucion&quot; END AS &quot;IdTipoCanalDistribucion&quot;,&#xD;
                CASE WHEN O.&quot;IdTipoVigenciaOrden&quot; = '' THEN NULL ELSE O.&quot;IdTipoVigenciaOrden&quot; END AS &quot;IdTipoVigenciaOrden&quot;,&#xD;
                O.&quot;IndicadorFacturacionInmediata&quot;,&#xD;
                CASE WHEN O.&quot;IdTipoCanalIngreso&quot; = '' THEN NULL ELSE O.&quot;IdTipoCanalIngreso&quot; END AS &quot;CanalIngreso&quot;,&#xD;
                O.&quot;EspecificaBolsa&quot;,&#xD;
                CASE WHEN O.&quot;IdTipoPrecio&quot; = '' THEN NULL ELSE O.&quot;IdTipoPrecio&quot; END AS &quot;TipoPrecio&quot;,&#xD;
                CASE WHEN O.&quot;IdTipoTasa&quot; = '' THEN NULL ELSE O.&quot;IdTipoTasa&quot; END AS &quot;TipoTasa&quot;,&#xD;
                IFNULL(FPAGOORD.&quot;IdMedioDePago&quot;,'CIN') AS &quot;IdMedioDePago&quot;,&#xD;
                IFNULL(MP.&quot;Nombre&quot;,'') AS &quot;MedioDePago&quot;,&#xD;
                CASE WHEN O.&quot;IdProducto&quot; = '' THEN NULL ELSE O.&quot;IdProducto&quot; END AS &quot;IdProducto&quot;,&#xD;
                CAST(TP.&quot;Nombre&quot; AS NVARCHAR(100)) AS &quot;NombreProducto&quot;,&#xD;
                CASE WHEN O.&quot;IdInstrumento&quot; = 0 THEN NULL ELSE O.&quot;IdInstrumento&quot; END AS &quot;IdInstrumento&quot;,&#xD;
                CASE WHEN O.&quot;IdClasificacionTipoInstrumento&quot; = '' THEN NULL ELSE O.&quot;IdClasificacionTipoInstrumento&quot; END AS &quot;IdClasificacionTipoInstrumento&quot;,&#xD;
                CASE WHEN O.&quot;IdTipoInstrumento&quot; = '' THEN NULL ELSE O.&quot;IdTipoInstrumento&quot; END AS &quot;IdTipoInstrumento&quot;,&#xD;
                CAST(TI.&quot;Nombre&quot; AS NVARCHAR(100)) AS &quot;NombreTipoInstrumento&quot;,&#xD;
                CASE WHEN O.&quot;IdClasificacionTipoInstrumento&quot; ='IF' THEN CAST(O.&quot;NemotecnicoSVS&quot; AS NVARCHAR(40)) ELSE CAST(O.&quot;Nemotecnico&quot; AS NVARCHAR(40)) END AS &quot;Nemotecnico&quot;,&#xD;
                CASE WHEN O.&quot;IdInstrumentoSubyacente&quot; = 0 THEN NULL ELSE O.&quot;IdInstrumentoSubyacente&quot; END AS &quot;IdInstrumentoSubyacente&quot;,&#xD;
                CASE WHEN O.&quot;IdInstrumentoSubyacente&quot; = 0 THEN  '' ELSE INS.&quot;Nemotecnico&quot; END AS &quot;InstrumentoSubyacente&quot;,&#xD;
                O.&quot;Cantidad&quot; AS &quot;ValorNominal&quot;,&#xD;
                CASE WHEN O.&quot;IdMonedaOrden&quot; = '' THEN NULL ELSE O.&quot;IdMonedaOrden&quot; END AS &quot;IdMonedaOrden&quot;,&#xD;
                CASE WHEN O.&quot;IdMonedaLiquidacionOrden&quot; = '' THEN NULL ELSE O.&quot;IdMonedaLiquidacionOrden&quot; END AS &quot;IdMonedaLiquidacionOrden&quot;, &#xD;
                CASE WHEN O.&quot;IdMonedaLiquidacionOrden&quot; = '' THEN NULL ELSE O.&quot;IdMonedaLiquidacionOrden&quot; END AS &quot;IdMonedaLiquidacionCobros&quot;,-- se coloca asi debido a que se elimino el campo en tabla de ordenes&#xD;
                O.&quot;PrecioOrden&quot;,    &#xD;
                O.&quot;PrecioMercado&quot;,&#xD;
                O.&quot;PlazoReporte&quot; as &quot;Plazo&quot;,&#xD;
                O.&quot;TipoCambio&quot;,&#xD;
                CCOP.&quot;Impuesto&quot;,&#xD;
                CCOP.&quot;ComisBVL&quot;,&#xD;
                CCOP.&quot;ComisGarantia&quot;,&#xD;
                CCOP.&quot;ComisCavali&quot;,&#xD;
                CCOP.&quot;ComisSMV&quot;,&#xD;
                CCOP.&quot;ComisSAB&quot;,&#xD;
                CCOP.&quot;PorcentajeComisSAB&quot;,&#xD;
                O.&quot;Cantidad&quot;,&#xD;
                CASE &#xD;
                    WHEN O.&quot;IdClasificacionTipoInstrumento&quot; = 'RE' THEN O.&quot;TasaReporte&quot;&#xD;
                    WHEN O.&quot;IdClasificacionTipoInstrumento&quot; = 'RF' THEN O.&quot;TasaRFIF&quot;&#xD;
                    ELSE 0.0 END &#xD;
                AS &quot;Tasa&quot;,&#xD;
                O.&quot;MontoLocal&quot;,&#xD;
                O.&quot;MontoOrden&quot;,&#xD;
                O.&quot;MontoLiquidacion&quot;,&#xD;
                CASE WHEN O.&quot;IdCondicionDeLiquidacion&quot; = '' THEN NULL ELSE O.&quot;IdCondicionDeLiquidacion&quot; END AS &quot;IdCondicionDeLiquidacion&quot;,&#xD;
                O.&quot;EsVentaCorta&quot;,&#xD;
                O.&quot;EsOrdenEspecial&quot; AS &quot;OrdenEspecial&quot;,&#xD;
                CAST(O.&quot;Glosa&quot; AS NVARCHAR(520)) AS &quot;Glosa&quot;,&#xD;
                CASE WHEN O.&quot;IdEstadoOrden&quot; = '' THEN NULL ELSE O.&quot;IdEstadoOrden&quot; END AS &quot;IdEstadoOrden&quot;,&#xD;
                CASE WHEN O.&quot;IdEstadoOrden&quot; = '' THEN NULL ELSE EO.&quot;Nombre&quot; END AS &quot;EstadoOrden&quot;,&#xD;
                CASE WHEN CEAO.&quot;IdEstadoAsignacion&quot; = '' THEN NULL ELSE CEAO.&quot;IdEstadoAsignacion&quot; END AS &quot;IdEstadoAsignacion&quot;,&#xD;
                CASE WHEN CEAO.&quot;IdEstadoAsignacion&quot; = '' THEN NULL ELSE EA.&quot;Nombre&quot; END AS &quot;EstadoAsignacion&quot;,&#xD;
                O.&quot;OrdenVigente&quot; AS &quot;IdEstadoVigenciaOrden&quot;,&#xD;
                P.&quot;IdEstado&quot; AS &quot;IdEstado&quot;,&#xD;
                EP.&quot;Nombre&quot; AS &quot;Estado&quot;,&#xD;
                O.&quot;Bloqueado&quot;,&#xD;
                CASE WHEN O.&quot;IdUsuarioBloqueo&quot; = 0 THEN NULL ELSE O.&quot;IdUsuarioBloqueo&quot; END AS &quot;IdUsuarioBloqueo&quot;,&#xD;
                CAST(O.&quot;MotivoBloqueo&quot; AS NVARCHAR(40)) AS &quot;MotivoBloqueo&quot;,&#xD;
                CASE WHEN P.&quot;IdTipoBloqueo&quot; = '' THEN NULL ELSE CAST(P.&quot;IdTipoBloqueo&quot; AS NVARCHAR(40)) END AS &quot;IdTipoBloqueo&quot;,&#xD;
                CASE WHEN P.&quot;IdTipoDesbloqueo&quot; = '' THEN NULL ELSE CAST(P.&quot;IdTipoDesbloqueo&quot; AS NVARCHAR(40)) END AS &quot;IdTipoDesbloqueo&quot;,&#xD;
                CAST(P.&quot;ComentarioDesbloqueo&quot; AS NVARCHAR(520)) AS &quot;ComentarioDesbloqueo&quot;,&#xD;
                CASE WHEN O.&quot;IdBoveda&quot; = '' THEN NULL ELSE CAST(O.&quot;IdBoveda&quot; AS NVARCHAR(40)) END AS &quot;IdTipoCustodia&quot;,&#xD;
                CASE WHEN O.&quot;IdFormaCustodia&quot; = '' THEN NULL ELSE O.&quot;IdFormaCustodia&quot; END AS &quot;IdFormaCustodia&quot;,&#xD;
                CASE WHEN O.&quot;IdCliente&quot; = 0 THEN NULL ELSE O.&quot;IdCliente&quot; END AS &quot;IdCliente&quot;,&#xD;
                CASE WHEN CC.&quot;IdPersona&quot; = 0 THEN NULL ELSE CC.&quot;IdPersona&quot; END AS &quot;IdPersona&quot;,&#xD;
              --  CAST(CC.&quot;DocumentoIdentidad&quot; AS NVARCHAR(40)) AS &quot;IUP&quot;,&#xD;
				CC.&quot;NombreCompleto&quot; AS &quot;NombreCompletoCliente&quot;,&#xD;
				CC.&quot;TipoDocumentoIdentidadAdicional&quot;,&#xD;
				CC.&quot;DocumentoIdentidadAdicional&quot;,&#xD;
                CAST(DI.&quot;IdTipoDocumentoIdentidadAsociado&quot; AS NVARCHAR(40)) AS &quot;TipoDeDocumento&quot;,&#xD;
                CAST(DI.&quot;DocumentoIdentidadAsociado&quot; AS NVARCHAR(40)) AS &quot;NumeroDocumento&quot;,&#xD;
                CAST(P.&quot;DescripcionPortafolio&quot; AS NVARCHAR(100)) AS &quot;DescripcionPortafolio&quot;,&#xD;
                CASE WHEN O.&quot;IdEmpleadoDigitador&quot; = 0 THEN NULL ELSE O.&quot;IdEmpleadoDigitador&quot; END AS &quot;IdEmpleadoDigitador&quot;,&#xD;
                CASE WHEN CE2.&quot;CodigoEmpleado&quot; = '' THEN NULL ELSE CE2.&quot;CodigoEmpleado&quot; END AS &quot;CodigoAsesorPortafolio&quot;, --------------------------&#xD;
                CAST(CE2.&quot;NombreCompleto&quot; AS NVARCHAR(100)) AS &quot;AsesorPortafolio&quot;,&#xD;
                CAST(CE2.&quot;IdSucursal&quot; AS NVARCHAR(100)) AS &quot;CodigoSucursal&quot;,&#xD;
                CAST(CE2.&quot;NombreSucursal&quot; AS NVARCHAR(100)) AS &quot;Sucursal&quot;,&#xD;
                CAST(P.&quot;CodigoPortafolio&quot; AS NVARCHAR(100)) AS &quot;CodigoPortafolio&quot;,&#xD;
                CASE WHEN CE.&quot;CodigoEmpleado&quot; = '' THEN NULL ELSE CE.&quot;CodigoEmpleado&quot; END AS &quot;CodigoEmpleadoDigitador&quot;,&#xD;
                CAST(PEA.&quot;NombreCompleto&quot; AS NVARCHAR(300)) AS &quot;AutorizadorDeOrden&quot;,&#xD;
                CASE WHEN O.&quot;IdPortafolioCliente&quot; = 0 THEN NULL ELSE O.&quot;IdPortafolioCliente&quot; END AS &quot;IdPortafolioCliente&quot;, &#xD;
                FDPO.&quot;NumeroCuentaBancaria&quot; AS &quot;CuentaBancariaOrden&quot;,&#xD;
                TCB.&quot;NombreTipoCuentaBancaria&quot; AS &quot;TipoCuentaBancariaOrden&quot;,&#xD;
                BE.&quot;Codigo&quot; AS &quot;Broker&quot;,&#xD;
                PEBRK.&quot;NombreCompleto&quot; AS &quot;NombreBroker&quot;&#xD;
            --TABLAS&#xD;
            FROM &quot;BSCL.Orden.BD::ORD.Orden&quot; O&#xD;
            INNER JOIN &quot;BSCL.Portafolio.BD::POR.Portafolio&quot; P ON P.&quot;IdCliente&quot; = O.&quot;IdCliente&quot; AND P.&quot;IdPortafolio&quot; = O.&quot;IdPortafolioCliente&quot;&#xD;
            INNER JOIN &quot;BSCL.SocioNegocio.BD.Vistas::CLI.ConsultarCliente&quot; CC ON CC.&quot;IdCliente&quot; = O.&quot;IdCliente&quot;&#xD;
            INNER JOIN &quot;BSCL.Plataforma.BD::INS.TipoProducto&quot; TP ON TP.&quot;IdTipoProducto&quot; = O.&quot;IdProducto&quot;&#xD;
            INNER JOIN &quot;BSCL.Plataforma.BD::INS.TipoInstrumento&quot; TI ON TI.&quot;IdTipoInstrumento&quot; = O.&quot;IdTipoInstrumento&quot;&#xD;
            INNER JOIN &quot;BSCL.Orden.BD.Vistas::ConsultarEstadoAsignacionOrden&quot; CEAO ON CEAO.&quot;IdOrden&quot; = O.&quot;IdOrden&quot;&#xD;
            INNER JOIN &quot;BSCL.SocioNegocio.BD::PER.DocumentoIdentidad&quot; DI ON DI.&quot;IdPersona&quot; = CC.&quot;IdPersona&quot; AND DI.&quot;DocumentoIdentidad&quot; = CC.&quot;DocumentoIdentidad&quot;&#xD;
            LEFT JOIN &quot;BSCL.Orden.BD::ORD.FormaDePagoOrden&quot; FPAGOORD ON FPAGOORD.&quot;IdOrden&quot; = O.&quot;IdOrden&quot;&#xD;
            LEFT JOIN &quot;BSCL.SocioNegocio.BD.Vistas::EMP.ConsultarEmpleado&quot; CE ON CE.&quot;IdEmpleado&quot; = O.&quot;IdEmpleadoDigitador&quot;&#xD;
            LEFT JOIN &quot;BSCL.SocioNegocio.BD.Vistas::EMP.ConsultarEmpleado&quot; CE2 ON CE2.&quot;IdEmpleado&quot; = O.&quot;IdEmpleadoPortafolio&quot;&#xD;
            LEFT JOIN &quot;BSCL.SocioNegocio.BD.Vistas::PER.ConsultarPersona&quot; PEA ON PEA.&quot;IdPersona&quot; = O.&quot;IdPersonaAutorizadoDarOrdenes&quot;&#xD;
            LEFT JOIN &quot;BSCL.Plataforma.BD::PLA.BrokerExtranjero&quot; BE ON BE.&quot;IdPersona&quot; = P.&quot;IdPersonaBrokerExtranjero&quot;&#xD;
            LEFT JOIN &quot;BSCL.SocioNegocio.BD.Vistas::PER.ConsultarPersona&quot; PEBRK ON PEBRK.&quot;IdPersona&quot; = P.&quot;IdPersonaBrokerExtranjero&quot;&#xD;
			LEFT JOIN &quot;BSCL.Plataforma.BD::INS.TipoOperacion&quot; AS TipoOperacion ON  TipoOperacion.&quot;IdTipoOperacion&quot; = O.&quot;IdTipoOperacion&quot;                &#xD;
            --nuevos&#xD;
            LEFT JOIN &quot;BSCL.Plataforma.BD::PAG.MedioDePago&quot; MP ON MP.&quot;IdMedioDePago&quot; = FPAGOORD.&quot;IdMedioDePago&quot;&#xD;
            LEFT JOIN &quot;BSCL.Plataforma.BD::INS.Instrumento&quot; INS ON INS.&quot;IdInstrumento&quot; = O.&quot;IdInstrumentoSubyacente&quot;&#xD;
            LEFT JOIN &quot;BSCL.Orden.BD.Vistas::ConsultarCobrosOrdenesPeru&quot; CCOP ON CCOP.&quot;IdOrden&quot; = O.&quot;IdOrden&quot;&#xD;
            LEFT JOIN &quot;BSCL.Plataforma.BD::PLA.Estado&quot; EO ON EO.&quot;IdEstado&quot; = O.&quot;IdEstadoOrden&quot;&#xD;
            LEFT JOIN &quot;BSCL.Plataforma.BD::PLA.Estado&quot; EA ON EA.&quot;IdEstado&quot; = CEAO.&quot;IdEstadoAsignacion&quot;&#xD;
            LEFT JOIN &quot;BSCL.Plataforma.BD::PLA.Estado&quot; EP ON EP.&quot;IdEstado&quot; = P.&quot;IdEstado&quot;&#xD;
            LEFT JOIN BSCL.&quot;BSCL.Orden.BD::ORD.FormaDePagoOrden&quot; FDPO ON FDPO.&quot;IdOrden&quot; = O.&quot;IdOrden&quot; AND FDPO.&quot;IdMedioDePago&quot; IN ('TRA','TBC')&#xD;
            LEFT JOIN &quot;BSCL.Plataforma.BD::BAN.TipoCuentaBancaria&quot; TCB ON FDPO.&quot;IdTipoCuentaBancaria&quot; = TCB.&quot;IdTipoCuentaBancaria&quot;&#xD;
            CROSS JOIN (select top 1 &quot;Valor&quot; from &quot;BSCL&quot;.&quot;BSCL.Plataforma.BD::PLA.Configuracion&quot; WHERE &quot;CodigoParametro&quot; = 'PLA.SegundosZonaHoraria') AS CONFIGURACION;&#xD;
    &#xD;
            
END /********* End Procedure Script ************/&#xD;
