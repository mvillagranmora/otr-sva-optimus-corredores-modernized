# HANA QA connection (the variables HANA_URL, HANA_USER and HANA_PASSWORD that a module needs are taken from these values and set in its environment). Copy to .env (git-ignored) and fill in. Never commit real values.
# dbURL : JDBC URL, e.g. jdbc:sap://<host>:<port>
# dbprop: extra JDBC properties as key=value separated by ';' (e.g. encrypt=true;validateCertificate=false)
# dbdrv : driver class (com.sap.db.jdbc.Driver when empty)
qa01.saphana.dbURL=
qa01.saphana.dbprop=
qa01.saphana.dbdrv=
qa01.saphana.dbuser=
qa01.saphana.dbpass=

# Postgres QA connection (same convention). Never commit real values.
# dbURL : JDBC URL with the database and the schema that holds the flat t_/v_/sp_ objects, e.g. jdbc:postgresql://<host>:<port>/<database>?currentSchema=<schema>
qa01.postgres.dbURL=
qa01.postgres.dbuser=
qa01.postgres.dbpass=
