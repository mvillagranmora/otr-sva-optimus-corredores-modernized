# HANA QA connection (read by hana-jdbc/run.sh). Copy to .env (git-ignored) and fill in. Never commit real values.
# dbURL : JDBC URL, e.g. jdbc:sap://<host>:<port>
# dbprop: extra JDBC properties as key=value separated by ';' (e.g. encrypt=true;validateCertificate=false)
# dbdrv : driver class (com.sap.db.jdbc.Driver when empty)
qa01.saphana.dbURL=
qa01.saphana.dbprop=
qa01.saphana.dbdrv=
qa01.saphana.dbuser=
qa01.saphana.dbpass=
