# ─────────────────────────────────────────────────────────────────────────────
# SEC-002: Add authentication gate to JOBMANAGER web.xml
# CWE-284 — Critical — ANT/config/Jobmanager.xml
# (a) Adds explicit <servlet>/<servlet-mapping> so the security-constraint applies
#     unambiguously in TomEE — resolves the @WebServlet annotation + web.xml
#     interaction edge-case identified in verification round 1.
# (b) Adds <transport-guarantee>CONFIDENTIAL</transport-guarantee> so BASIC auth
#     credentials cannot be transmitted in cleartext.
# Team must configure a TomEE realm (JDBC, LDAP, or Kerberos) and assign users to
# role ADMIN before deploying.
# ─────────────────────────────────────────────────────────────────────────────
--- a/BSCL/Plataforma/JAVA/ANT/config/Jobmanager.xml
+++ b/BSCL/Plataforma/JAVA/ANT/config/Jobmanager.xml
@@ -9,4 +9,26 @@
     <welcome-file>default.htm</welcome-file>
     <welcome-file>default.jsp</welcome-file>
   </welcome-file-list>
+  <servlet>
+    <servlet-name>WebAdmin</servlet-name>
+    <servlet-class>cl.bcs.scheduler.web.WebAdmin</servlet-class>
+  </servlet>
+  <servlet-mapping>
+    <servlet-name>WebAdmin</servlet-name>
+    <url-pattern>/admin</url-pattern>
+  </servlet-mapping>
+  <security-constraint>
+    <web-resource-collection>
+      <web-resource-name>Admin</web-resource-name>
+      <url-pattern>/admin</url-pattern>
+    </web-resource-collection>
+    <auth-constraint>
+      <role-name>ADMIN</role-name>
+    </auth-constraint>
+    <user-data-constraint>
+      <transport-guarantee>CONFIDENTIAL</transport-guarantee>
+    </user-data-constraint>
+  </security-constraint>
+  <login-config>
+    <auth-method>BASIC</auth-method>
+    <realm-name>JobManagerAdmin</realm-name>
+  </login-config>
+  <security-role>
+    <role-name>ADMIN</role-name>
+  </security-role>
 </web-app>

